---
import LBRNavigation from './LBRNavigation.astro';

const { activeView = '' } = Astro.props;
---

<header class="lbr-shell-header lbr-card" data-active-view={activeView}>
  <div class="lbr-utility-row">
    <div class="lbr-utility-message"><span class="lbr-new-badge">NEW</span><span>Try real GitHub robots live in your browser—zero Linux or hardware needed.</span>
      <span class="eng-only-inline lbr-ram-badge" id="lbr-ram-badge">Active Sim: None (0 MB RAM)</span>
    </div>
    <div class="lbr-utility-controls">
      <span class="eng-only-inline lbr-ram-badge" title="Local tools only; no remote simulator is loaded">RAM · 0 MB idle</span>
      <label class="lbr-control">
        <span class="sr-only">Experience mode</span>
        <select id="lbr-mode" aria-label="Experience mode">
          <option value="beginner">🌱 Beginner View (Simple)</option>
          <option value="engineer">⚙️ Engineer View (Full Specs)</option>
        </select>
      </label>
      <label class="lbr-control">
        <span class="sr-only">Shopping region</span>
        <select id="region-select" aria-label="Shopping region">
          <option value="IN">🇮🇳 India (₹ INR)</option>
          <option value="US">🇺🇸 USA &amp; Global ($ USD)</option>
        </select>
      </label>
      <button id="lbr-theme-toggle" class="lbr-icon-button" type="button" aria-label="Switch to dark mode" aria-pressed="false">☾</button>
      <button id="lbr-close-sim" class="lbr-close-button" type="button" hidden>⏹ Close Running Sim</button>
    </div>
  </div>

  <LBRNavigation activeView={activeView} />
</header>

<script>
  import { clearActiveIsland } from '../utils/islandRegistry';

  const mode = document.querySelector<HTMLSelectElement>('#lbr-mode');
  const region = document.querySelector<HTMLSelectElement>('#region-select');
  const themeToggle = document.querySelector<HTMLButtonElement>('#lbr-theme-toggle');
  const closeSim = document.querySelector<HTMLButtonElement>('#lbr-close-sim');
  const ramBadge = document.querySelector<HTMLElement>('#lbr-ram-badge');

  const savedMode = localStorage.getItem('lbr-mode');
  const savedRegion = localStorage.getItem('lbr-region') ?? localStorage.getItem('lbr-country');
  const savedTheme = localStorage.getItem('lbr-theme');
  if (savedMode === 'engineer' || savedMode === 'beginner') {
    if (mode) mode.value = savedMode;
    document.body.classList.toggle('engineer-mode', savedMode === 'engineer');
  }
  if (savedRegion === 'IN' || savedRegion === 'US') {
    if (region) region.value = savedRegion;
    document.documentElement.dataset.region = savedRegion;
    document.documentElement.dataset.country = savedRegion;
  }

  function setTheme(theme: 'light' | 'dark') {
    const isDark = theme === 'dark';
    document.documentElement.classList.toggle('dark', isDark);
    if (themeToggle) {
      themeToggle.textContent = isDark ? '☀' : '☾';
      themeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      themeToggle.setAttribute('aria-pressed', String(isDark));
    }
    localStorage.setItem('lbr-theme', theme);
  }

  if (savedTheme === 'dark' || savedTheme === 'light') setTheme(savedTheme);

  mode?.addEventListener('change', () => {
    document.body.classList.toggle('engineer-mode', mode.value === 'engineer');
    localStorage.setItem('lbr-mode', mode.value);
  });

  region?.addEventListener('change', () => {
    document.documentElement.dataset.region = region.value;
    document.documentElement.dataset.country = region.value;
    localStorage.setItem('lbr-region', region.value);
    window.dispatchEvent(new CustomEvent('lbr:region-change', { detail: region.value }));
    // Keep the existing Forge listener working while consumers migrate to the region event.
    window.dispatchEvent(new CustomEvent('lbr:country-change', { detail: region.value }));
  });

  themeToggle?.addEventListener('click', () => setTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark'));
  closeSim?.addEventListener('click', clearActiveIsland);

  function syncActiveTool() {
    const name = window.__LBR_ACTIVE_TOOL_NAME__;
    if (ramBadge) ramBadge.textContent = `Active Sim: ${name ? `${name} (≈ active)` : 'None (0 MB RAM)'}`;
    if (closeSim) closeSim.hidden = !name;
  }
  window.addEventListener('lbr:active-tool-change', syncActiveTool);
  window.setInterval(syncActiveTool, 500);
  syncActiveTool();
</script>
