---
interface Props {
  activeView?: string;
}

import components from '../data/components.json';
const { activeView = '' } = Astro.props;
const tabs = [
  { id: 'robots', label: '01 · Robot Lab', href: '/robots/' },
  { id: 'forge', label: '02 · Build Forge', href: '/forge/' },
  { id: 'playground', label: '03 · Pose Lab', href: '/playground/' },
  { id: 'tools', label: '04 · Instruments (6)', href: '/tools/' },
  { id: 'components', label: `05 · Parts (${components.length})`, href: '/components/' },
  { id: 'traps', label: '06 · Pin Guide', href: '/traps/' },
  { id: 'roadmap', label: '07 · Learning Path', href: '/roadmap/' },
  { id: 'earn', label: '08 · Partner', href: '/earn/' },
];
---

<nav class="lbr-nav" aria-label="Main navigation"><a href="/" aria-label="Let's Build Robots home">LBR Home</a>
  {tabs.map((tab) => (
    <a class:list={{ 'is-active': activeView === tab.id }} href={tab.href} aria-current={activeView === tab.id ? 'page' : undefined}>
      {tab.label}
    </a>
  ))}
</nav>
