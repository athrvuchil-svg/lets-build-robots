---
interface Props {
  activeView?: string;
}

const { activeView = '' } = Astro.props;
const tabs = [
  { id: 'robots', label: '🚀 1. Try Live Robots', href: '/robots/' },
  { id: 'forge', label: '🛒 2. Part Picker', href: '/forge/' },
  { id: 'playground', label: '🦾 3. 3D Leg & Arm Lab', href: '/playground/' },
  { id: 'tools', label: '⚡ 4. Calculators (6)', href: '/tools/' },
  { id: 'components', label: '📦 5. Hardware Catalog (23)', href: '/components/' },
  { id: 'traps', label: '💡 6. Mistake Saver Wiki', href: '/traps/' },
  { id: 'roadmap', label: '🗺️ 7. Roadmap & Challenges', href: '/roadmap/' },
];
---

<nav class="lbr-nav" aria-label="Main navigation"><a href="/" aria-label="Let's Build Robots home">LBR Home</a>
  {tabs.map((tab) => (
    <a class:list={{ 'is-active': activeView === tab.id }} href={tab.href} aria-current={activeView === tab.id ? 'page' : undefined}>
      {tab.label}
    </a>
  ))}
</nav>
