---
import components from '../data/components.json';
const groups: [string, string[]][] = [
  ['1. Robot Brains (Microcontrollers)', ['esp32-devkit-v1', 'arduino-uno-r3']],
  ['2. Motors & Joints', ['mg90s-servo-x4', 'mg90s-servo-x12', 'dc-gearmotor-12v']],
  ['3. Power & Motor Controllers', ['pca9685-16ch', 'buck-5v-8a', 'l298n-driver', 'tb6600-driver', 'lipo-2s-2200', 'bat-9v-alkaline']],
  ['4. Sensors & Adapters', ['mpu6050-imu', 'ds3231-rtc-0x68', 'hcsr04-5v', 'txs0108e-shifter']],
];
const presets = {
  'spiderbot-good': ['esp32-devkit-v1', 'mg90s-servo-x12', 'pca9685-16ch', 'buck-5v-8a', 'lipo-2s-2200', 'mpu6050-imu'],
  'spiderbot-bad': ['esp32-devkit-v1', 'mg90s-servo-x12', 'bat-9v-alkaline', 'hcsr04-5v'],
  conveyor: ['esp32-devkit-v1', 'dc-gearmotor-12v', 'tb6600-driver', 'lipo-2s-2200', 'hcsr04-5v', 'txs0108e-shifter'],
  'esp32-safe': ['esp32-devkit-v1', 'mpu6050-imu', 'hcsr04-5v', 'txs0108e-shifter', 'lipo-2s-2200', 'buck-5v-8a'],
  clear: [],
};
---

<div class="not-content" data-forge>
  <div class="lbr-forge-toolbar"><div><p class="lbr-kicker">PCPartPicker for robots</p><h2 class="text-2xl font-bold">Choose your budget path</h2><p class="lbr-muted-copy">There is more than one way to build. LBR shows the trade-offs and the unsafe shortcuts.</p></div><label class="lbr-switch"><input type="checkbox" checked data-wifi /><span>Using Wi-Fi / phone control</span></label></div>
  <div class="mb-5 flex flex-wrap gap-2" data-presets><button class="lbr-preset-button" data-preset="spiderbot-good">✅ Load Working Spiderbot Kit</button><button class="lbr-preset-button" data-preset="spiderbot-bad">⚠️ See Common Beginner Mistake</button><button class="lbr-preset-button" data-preset="conveyor">⚙️ Load Conveyor Kit</button><button class="lbr-preset-button" data-preset="esp32-safe">📡 Safe ESP32 Starter Kit</button><button class="lbr-preset-button" data-preset="clear">↺ Clear</button></div>
  <div class="grid gap-6 lg:grid-cols-[1.25fr_.75fr]">
    <section class="space-y-5">{groups.map(([title, ids]) => <div class="lbr-card p-5"><p class="lbr-kicker">{title}</p><div class="mt-3 grid gap-3 sm:grid-cols-2">{ids.map((id) => { const component = components.find((item) => item.id === id); return component && <label class="lbr-part-card"><input type="checkbox" value={component.id} data-part /><span><strong>{component.part}</strong><small data-price data-in={`${component.in.store} · ₹${component.in.price}`} data-us={`${component.us.store} · $${component.us.price.toFixed(2)}`}>{component.in.store} · ₹{component.in.price}</small><span class="eng-only-inline font-mono text-[10px]">{component.kind}</span></span></label>; })}</div></div>)}</section>
     <aside class="lbr-card lbr-build-report" aria-live="polite"><div class="flex items-center justify-between"><div><p class="lbr-kicker">Build report</p><h2 class="text-2xl font-bold">Know before you wire</h2></div><span data-status-badge class="lbr-status-badge">READY</span></div><div class="lbr-metric-grid" data-metrics></div><div class="mt-4 space-y-2" data-rules></div><div class="mt-5" data-bom></div><div class="mt-4" data-orders></div><button class="lbr-button lbr-button-primary mt-4" type="button" data-copy-bom>📋 Copy Shopping List</button></aside>
  </div>
</div>

<script define:vars={{ components, presets }}>
  const root = document.querySelector('[data-forge]');
  const inputs = [...(root?.querySelectorAll<HTMLInputElement>('[data-part]') ?? [])];
   const metrics = root?.querySelector('[data-metrics]'); const rules = root?.querySelector('[data-rules]'); const bom = root?.querySelector('[data-bom]'); const orders = root?.querySelector('[data-orders]'); const badge = root?.querySelector('[data-status-badge]');
  let region = localStorage.getItem('lbr-region') === 'US' ? 'US' : 'IN';
  const format = (n) => region === 'US' ? `$${n.toFixed(2)}` : `₹${n.toFixed(0)}`;
  const selected = () => components.filter((part) => inputs.some((input) => input.checked && input.value === part.id));
  const card = (kind, text) => `<div class="lbr-rule lbr-rule-${kind}">${text}</div>`;
   function update() {
     const parts = selected(); const ids = new Set(parts.map((part) => part.id)); const mcus = parts.filter((part) => part.kind === 'MCU'); const mcu = mcus[0]; const batteries = parts.filter((part) => part.kind === 'battery');
     const actuatorParts = parts.filter((part) => ['servo', 'motor'].includes(part.kind)); const actuatorStallA = actuatorParts.reduce((sum, part) => sum + part.stallA, 0); const servoStallA = parts.filter((part) => part.kind === 'servo').reduce((sum, part) => sum + part.stallA, 0); const pwmNeeded = actuatorParts.reduce((sum, part) => sum + part.pwm, 0); const pwmAvailable = (mcu?.pwm ?? 0) + (ids.has('pca9685-16ch') ? 16 : 0); const maxBatteryA = batteries.length ? Math.max(...batteries.map((part) => part.stallA)) : 0; const requiredSupplyA = actuatorStallA * 1.25; const weight = parts.reduce((sum, part) => sum + part.weightG, 110); const hasClash = ids.has('mpu6050-imu') && ids.has('ds3231-rtc-0x68');
     const failures = []; const warnings = []; const ok = [];
    if (!mcu) failures.push('🛑 No Robot Brain Selected: Pick an ESP32 or Arduino Uno first.');
     if (actuatorStallA && !batteries.length) failures.push('🛑 No battery selected: add a supported power source before wiring.'); else if (actuatorStallA && requiredSupplyA > maxBatteryA) failures.push(`🛑 Weak Battery Warning: your actuators need ${requiredSupplyA.toFixed(1)}A with headroom, but the selected battery provides ${maxBatteryA.toFixed(1)}A max.`); else if (actuatorStallA) ok.push('✅ Battery Power OK');
     const regulator = parts.find((part) => part.id === 'buck-5v-8a'); const railCapacity = regulator?.max5vA ?? 0; if (servoStallA > 0.6 && !regulator) failures.push(`🛑 Board Reset Danger: your servos can pull ${servoStallA.toFixed(1)}A. Add a separate 5V regulator instead of using the MCU rail.`); else if (servoStallA * 1.25 > railCapacity) failures.push(`🛑 Regulator Overload: the servo rail needs ${(servoStallA * 1.25).toFixed(1)}A with headroom, but the selected regulator is rated ${railCapacity.toFixed(1)}A.`); else if (servoStallA) ok.push('✅ Servo Power Rail Sized');
    if (pwmNeeded >= 8 && !ids.has('pca9685-16ch')) warnings.push(`⚠️ Too Many Motor Wires (${pwmNeeded} channels): Add the PCA9685 16-channel Motor Controller Board.`); else ok.push('✅ Clean Wiring');
    if (ids.has('esp32-devkit-v1') && ids.has('hcsr04-5v') && !ids.has('txs0108e-shifter')) failures.push('🛑 Pin Burn Risk: The HC-SR04 sensor sends 5V into your 3.3V ESP32. Add the 5V-to-3.3V Safe Pin Adapter.');
     const wifi = root?.querySelector<HTMLInputElement>('[data-wifi]')?.checked ?? false; if (wifi && ids.has('esp32-devkit-v1')) warnings.push('📡 Wi-Fi ADC2 Tip: use ADC1 GPIO 32–39 for analog sensors while Wi-Fi is on; GPIO 0/12 are startup traps and GPIO 34–39 are input-only.');
    if (hasClash) failures.push('🛑 Conflict 0x68: MPU-6050 and DS3231 share the address. Pull MPU-6050 AD0 to 3.3V to switch it to 0x69.'); else ok.push('✅ I2C Addresses Clear');
    if (ids.has('l298n-driver')) warnings.push('🔥 L298N Heat Warning: the old BJT driver drops voltage as heat; TB6612FNG/BTS7960 MOSFET drivers run cooler.');
     const total = parts.reduce((sum, part) => sum + (region === 'US' ? part.us.price : part.in.price), 0); const threshold = region === 'US' ? 35 : 500; const shipping = total < threshold ? (region === 'US' ? 5.99 : 60) : 0; const stores = [...new Set(parts.map((part) => region === 'US' ? part.us.store : part.in.store))];
     if (parts.length && total < threshold) warnings.push(`🚚 ${region === 'US' ? 'USA' : 'Robu.in'} basket is ${format(total)} — add ${format(threshold - total)} to reach free shipping.`); if (region === 'IN' && stores.includes('Quartz')) warnings.push('🚚 Quartz Components uses ₹499 free shipping and ₹59 below it; separate Quartz items can add a second delivery charge.'); if (stores.length > 1) warnings.push(`📦 Split-order check: this list spans ${stores.join(', ')}. Compare delivery totals before buying.`);
    if (badge) { badge.textContent = failures.length ? '🛑 NEEDS FIXES' : warnings.length ? '⚠️ CHECK TIPS' : '✅ READY TO BUILD'; badge.className = `lbr-status-badge ${failures.length ? 'is-bad' : warnings.length ? 'is-warn' : 'is-good'}`; }
     if (metrics) metrics.innerHTML = `<div><strong>POWER NEEDED</strong><b>${actuatorStallA.toFixed(1)} A</b><small>Battery: ${maxBatteryA.toFixed(1)} A max · +25% headroom</small></div><div><strong>ROBOT WEIGHT</strong><b>${weight} g</b><small>Includes +110g frame</small></div><div><strong>MOTOR PINS</strong><b>${pwmNeeded} / ${pwmAvailable || 0}</b><small>Sensors: ${hasClash ? 'Conflict 0x68' : 'OK'}</small></div>`;
    if (rules) rules.innerHTML = [...failures.map((text) => card('bad', text)), ...warnings.map((text) => card('warn', text)), ...ok.map((text) => card('good', text))].join('') || card('neutral', 'Select a preset or parts to generate the six-rule report.');
     if (bom) bom.innerHTML = `<h3 class="text-lg font-bold">Shopping List</h3><div class="lbr-bom-table">${parts.map((part) => `<div><span>${part.part}<small class="lbr-muted-copy">${region === 'US' ? part.us.store : part.in.store}</small></span><b>${format(region === 'US' ? part.us.price : part.in.price)}</b></div>`).join('') || '<p class="lbr-muted-copy">No parts selected yet.</p>'}</div><div class="lbr-bom-total"><span>All orders + delivery</span><b>${format(total + shipping)}</b></div>`;
     if (orders) { const grouped = new Map(); parts.forEach((part) => { const store = region === 'US' ? part.us.store : part.in.store; grouped.set(store, (grouped.get(store) ?? 0) + (region === 'US' ? part.us.price : part.in.price)); }); const orderRows = Array.from(grouped.entries()).map((entry) => { const store = entry[0]; const subtotal = entry[1]; const storeThreshold = region === 'US' ? 35 : store === 'Quartz' ? 499 : store === 'Robu.in' ? 500 : Infinity; const storeShipping = subtotal < storeThreshold ? (region === 'US' ? 5.99 : store === 'Quartz' ? 59 : store === 'Robu.in' ? 60 : 0) : 0; const gap = Number.isFinite(storeThreshold) && subtotal < storeThreshold ? ` · add ${format(storeThreshold - subtotal)} for free delivery` : ' · free delivery threshold reached'; return `<div class="lbr-order-row"><span><b>${store}</b><small>${format(subtotal)}${gap}</small></span><strong>${format(subtotal + storeShipping)}</strong></div>`; }).join(''); orders.innerHTML = grouped.size ? `<h3 class="text-sm font-bold">Delivery optimizer</h3>${orderRows}` : ''; }
    root?.querySelectorAll<HTMLElement>('[data-price]').forEach((node) => { node.textContent = region === 'US' ? node.dataset.us ?? '' : node.dataset.in ?? ''; });
  }
  function applyPreset(name) { const ids = presets[name] ?? []; inputs.forEach((input) => { input.checked = ids.includes(input.value); }); update(); }
  root?.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.addEventListener('click', () => applyPreset(button.dataset.preset ?? 'clear')));
  inputs.forEach((input) => input.addEventListener('change', update)); root?.querySelector('[data-wifi]')?.addEventListener('change', update);
  window.addEventListener('lbr:region-change', (event) => { region = event.detail === 'US' ? 'US' : 'IN'; update(); }); window.addEventListener('lbr:country-change', (event) => { region = event.detail === 'US' ? 'US' : 'IN'; update(); });
  root?.querySelector('[data-copy-bom]')?.addEventListener('click', async () => { const text = selected().map((part) => `${part.part} — ${format(region === 'US' ? part.us.price : part.in.price)}`).join('\n'); await navigator.clipboard?.writeText(text || 'No parts selected'); });
  const query = new URLSearchParams(location.search).get('preset'); applyPreset(query && presets[query] ? query : 'spiderbot-good');
</script>
