---
import components from '../data/components.json';
const groups: [string, string[]][] = [
  ['1. Robot Brains', ['esp32-devkit-v1', 'arduino-uno-r3', 'esp8266-nodemcu', 'arduino-nano', 'rp2040-pico-w']],
  ['2. Motors & Joints', ['mg90s-servo-x4', 'mg90s-servo-x12', 'sg90-servo-x4', 'mg996r-servo-x4', 'dc-gearmotor-12v', 'tt-gearmotor-x2', 'n20-gearmotor', 'nema17-stepper', '28byj48-stepper']],
  ['3. Power & Drivers', ['pca9685-16ch', 'buck-5v-8a', 'buck-5v-3a', 'l298n-driver', 'tb6600-driver', 'a4988-driver', 'drv8825-driver', 'bts7960-driver', 'tmc2209-driver', 'lipo-2s-2200', 'lipo-1s-1000', '18650-2s-pack', 'bat-9v-alkaline', 'usb-c-5v-3a', 'fuse-holder-5a']],
  ['4. Sensors & Logic', ['mpu6050-imu', 'ds3231-rtc-0x68', 'hcsr04-5v', 'txs0108e-shifter', 'bme280-env', 'vl53l0x-tof', 'ssd1306-oled', 'ina219-power', 'ds18b20-temp', 'ec11-encoder', 'qtr-8a-line-array', 'ir-obstacle-pair', 'hc-sr501-pir', 'mpu9250-imu', 'apds9960-gesture', 'bh1750-light', 'hall-effect-a3144', 'analog-joystick']],
  ['5. Chassis & Wiring', ['robot-wheel-65mm', '2wd-chassis', 'caster-wheel', 'breadboard-830', 'jumper-wire-kit']],
];
const presets = {
  'spiderbot-good': ['esp32-devkit-v1', 'mg90s-servo-x12', 'pca9685-16ch', 'buck-5v-8a', 'lipo-2s-2200', 'mpu6050-imu'],
  'spiderbot-bad': ['esp32-devkit-v1', 'mg90s-servo-x12', 'bat-9v-alkaline', 'hcsr04-5v'],
  conveyor: ['esp32-devkit-v1', 'dc-gearmotor-12v', 'tb6600-driver', 'lipo-2s-2200', 'hcsr04-5v', 'txs0108e-shifter'],
  'esp32-safe': ['esp32-devkit-v1', 'mpu6050-imu', 'hcsr04-5v', 'txs0108e-shifter', 'lipo-2s-2200', 'buck-5v-8a'],
  clear: [],
};
const partById = Object.fromEntries(components.map((part) => [part.id, part]));
const catalogJson = JSON.stringify(components);
---

<div class="not-content" data-forge>
  <script type="application/json" data-forge-catalog set:html={catalogJson}></script>
  <script type="application/json" data-forge-presets set:html={JSON.stringify(presets)}></script>
  <div class="lbr-forge-toolbar"><div><p class="lbr-kicker">PCPartPicker for robots</p><h2 class="text-2xl font-bold">Choose a working path</h2><p class="lbr-muted-copy">Presets are real selections, not screenshots. Every change recalculates power, pins, addresses, weight, shipping, and buy links.</p></div><label class="lbr-switch"><input type="checkbox" checked data-wifi /><span>Using Wi-Fi / phone control</span></label></div>
  <div class="lbr-preset-strip" data-presets aria-label="Forge presets"><button class="lbr-preset-button" data-preset="spiderbot-good">✅ Load Working Spiderbot Kit</button><button class="lbr-preset-button" data-preset="spiderbot-bad">⚠️ See Common Beginner Mistake</button><button class="lbr-preset-button" data-preset="conveyor">⚙️ Load Conveyor Kit</button><button class="lbr-preset-button" data-preset="esp32-safe">📡 Safe ESP32 Starter Kit</button><button class="lbr-preset-button" data-preset="clear">↺ Clear</button></div>
  <div class="grid gap-6 lg:grid-cols-[1.25fr_.75fr]">
    <section class="space-y-5">
      {groups.map(([title, ids]) => <div class="lbr-card p-5"><p class="lbr-kicker">{title}</p><div class="mt-3 grid gap-3 sm:grid-cols-2">{ids.map((id) => { const component = partById[id]; return component && <label class="lbr-part-card" data-part-card={component.id}><input type="checkbox" value={component.id} data-part /><span><strong>{component.part}</strong><small data-price data-in={`${component.in.store} · ₹${component.in.price}`} data-us={`${component.us.store} · $${component.us.price.toFixed(2)}`}>{component.in.store} · ₹{component.in.price}</small><span class="lbr-buy-row"><a href={component.in.url} data-buy-link data-in-url={component.in.url} data-us-url={component.us.url} target="_blank" rel="noopener noreferrer">🛒 Buy on {component.in.store} ↗</a></span><span class="eng-only-inline font-mono text-[10px]">{component.kind}{component.i2c ? ` · ${component.i2c}` : ''}{component.logicV ? ` · ${component.logicV}V logic` : ''}</span></span></label>; })}</div></div>)}
    </section>
    <aside class="lbr-card lbr-build-report" aria-live="polite"><div class="flex items-center justify-between"><div><p class="lbr-kicker">Build report</p><h2 class="text-2xl font-bold">Know before you wire</h2></div><span data-status-badge class="lbr-status-badge">READY</span></div><div class="lbr-metric-grid" data-metrics></div><div class="mt-4 space-y-2" data-rules></div><div class="mt-5" data-bom></div><div class="mt-4" data-orders></div><button class="lbr-button lbr-button-primary mt-4" type="button" data-copy-bom>📋 Copy Shopping List</button><span class="lbr-copy-status" data-copy-status role="status" aria-live="polite"></span></aside>
  </div>
</div>

<script>
  // @ts-nocheck
  const catalog = JSON.parse(document.querySelector('[data-forge-catalog]')?.textContent || '[]');
  const presetMap = JSON.parse(document.querySelector('[data-forge-presets]')?.textContent || '{}');
  const root = document.querySelector('[data-forge]');
  const inputs = [...(root?.querySelectorAll('[data-part]') ?? [])];
  const metrics = root?.querySelector('[data-metrics]'); const rules = root?.querySelector('[data-rules]'); const bom = root?.querySelector('[data-bom]'); const orders = root?.querySelector('[data-orders]'); const badge = root?.querySelector('[data-status-badge]');
  let region = localStorage.getItem('lbr-region') === 'US' ? 'US' : 'IN';
  const format = (n) => region === 'US' ? `$${n.toFixed(2)}` : `₹${n.toFixed(0)}`;
  const partMap = new Map(catalog.map((part) => [part.id, part]));
  const selected = () => catalog.filter((part) => inputs.some((input) => input.checked && input.value === part.id));
  const card = (kind, text) => `<div class="lbr-rule lbr-rule-${kind}">${text}</div>`;
  function update() {
    const parts = selected(); const ids = new Set(parts.map((part) => part.id)); const mcu = parts.find((part) => part.kind === 'MCU'); const batteries = parts.filter((part) => part.kind === 'battery'); const actuators = parts.filter((part) => ['servo', 'motor', 'stepper'].includes(part.kind)); const servoStallA = parts.filter((part) => part.kind === 'servo').reduce((sum, part) => sum + (part.stallA || 0), 0); const actuatorStallA = actuators.reduce((sum, part) => sum + (part.stallA || 0), 0); const pwmNeeded = actuators.reduce((sum, part) => sum + (part.pwm || 0), 0); const pwmAvailable = (mcu?.pwm || 0) + (ids.has('pca9685-16ch') ? 16 : 0); const requiredSupplyA = actuatorStallA * 1.25; const maxBatteryA = batteries.length ? Math.max(...batteries.map((part) => part.maxContinuousA ?? part.stallA ?? 0)) : 0; const regulator = parts.find((part) => part.id === 'buck-5v-8a'); const railCapacity = regulator?.max5vA || 0; const addressCounts = {}; parts.filter((part) => part.i2c).forEach((part) => { addressCounts[part.i2c] = (addressCounts[part.i2c] || 0) + 1; }); const clashes = Object.keys(addressCounts).filter((address) => addressCounts[address] > 1); const failures = []; const warnings = []; const ok = []; if (!mcu) failures.push('🛑 Choose a robot brain before wiring.'); if (actuatorStallA && !batteries.length) failures.push('🛑 No battery selected: add a supported power source.'); else if (actuatorStallA && requiredSupplyA > maxBatteryA) failures.push(`🛑 Battery headroom is short: ${requiredSupplyA.toFixed(1)}A needed, ${maxBatteryA.toFixed(1)}A rated.`); else if (actuatorStallA) ok.push('✅ Battery headroom passes'); if (servoStallA > 0.6 && !regulator) failures.push(`🛑 Servo rail risk: ${servoStallA.toFixed(1)}A stall current cannot come from the controller 5V rail.`); else if (servoStallA && servoStallA * 1.25 > railCapacity) failures.push(`🛑 5V regulator overload: ${(servoStallA * 1.25).toFixed(1)}A required, ${railCapacity.toFixed(1)}A rated.`); else if (servoStallA) ok.push('✅ Separate servo rail passes'); if (pwmNeeded >= 8 && !ids.has('pca9685-16ch')) warnings.push(`⚠️ ${pwmNeeded} PWM channels requested: add the PCA9685.`); else if (pwmNeeded) ok.push('✅ PWM budget passes'); if (ids.has('esp32-devkit-v1') && ids.has('hcsr04-5v') && !ids.has('txs0108e-shifter')) failures.push('🛑 HC-SR04 Echo is 5V; protect the 3.3V ESP32 input.'); if ((root?.querySelector('[data-wifi]')?.checked ?? true) && ids.has('esp32-devkit-v1')) warnings.push('📡 Wi-Fi is on: use ADC1 GPIO 32–39 for analog sensors.'); if (clashes.length) failures.push(`🛑 I²C collision at ${clashes.join(', ')}: change an address strap.`); else if (parts.some((part) => part.i2c)) ok.push('✅ I²C addresses are unique'); if (ids.has('l298n-driver')) warnings.push('🔥 L298N is lossy and hot; a MOSFET driver is the cooler choice.'); const price = (part) => region === 'US' ? part.us.price : part.in.price; const total = parts.reduce((sum, part) => sum + price(part), 0); const threshold = region === 'US' ? 35 : 500; const shipping = total < threshold ? (region === 'US' ? 5.99 : 60) : 0; const weight = parts.reduce((sum, part) => sum + (part.weightG || 0), 110); const report = { failures, warnings, ok, actuatorStallA, servoStallA, pwmNeeded, pwmAvailable, requiredSupplyA, maxBatteryA, weight, total, threshold, shipping, clashes };
    if (badge) { badge.textContent = report.failures.length ? '🛑 NEEDS FIXES' : report.warnings.length ? '⚠️ CHECK TIPS' : '✅ READY TO BUILD'; badge.className = `lbr-status-badge ${report.failures.length ? 'is-bad' : report.warnings.length ? 'is-warn' : 'is-good'}`; }
    if (metrics) metrics.innerHTML = `<div><strong>POWER NEEDED</strong><b>${report.actuatorStallA.toFixed(1)} A</b><small>Supply target ${report.requiredSupplyA.toFixed(1)} A · battery ${report.maxBatteryA.toFixed(1)} A</small></div><div><strong>ROBOT WEIGHT</strong><b>${report.weight} g</b><small>Includes 110g frame estimate</small></div><div><strong>MOTOR PINS</strong><b>${report.pwmNeeded} / ${report.pwmAvailable}</b><small>${report.clashes.length ? `I²C ${report.clashes.join(', ')}` : 'address scan clear'}</small></div>`;
    if (rules) rules.innerHTML = [...report.failures.map((text) => card('bad', text)), ...report.warnings.map((text) => card('warn', text)), ...report.ok.map((text) => card('good', text))].join('') || card('neutral', 'Choose a preset or tick parts to generate a live report.');
    if (bom) bom.innerHTML = `<h3 class="text-lg font-bold">Shopping List</h3><div class="lbr-bom-table">${parts.map((part) => { const shop = region === 'US' ? part.us : part.in; return `<div><span><b>${part.part}</b><small>${shop.store}</small><a href="${shop.url}" target="_blank" rel="noopener noreferrer">🛒 Buy on ${shop.store} ↗</a></span><b>${format(shop.price)}</b></div>`; }).join('') || '<p class="lbr-muted-copy">No parts selected yet.</p>'}</div><div class="lbr-bom-total"><span>Parts + estimated delivery</span><b>${format(report.total + report.shipping)}</b></div>`;
    if (orders) { const grouped = new Map(); parts.forEach((part) => { const shop = region === 'US' ? part.us : part.in; grouped.set(shop.store, (grouped.get(shop.store) ?? 0) + shop.price); }); orders.innerHTML = grouped.size ? `<h3 class="text-sm font-bold">Delivery optimizer</h3>${Array.from(grouped.entries()).map(([store, subtotal]) => { const threshold = region === 'US' ? 35 : store === 'Quartz Components' ? 499 : store === 'Robu.in' ? 500 : Infinity; const fee = subtotal < threshold ? (region === 'US' ? 5.99 : store === 'Quartz Components' ? 59 : store === 'Robu.in' ? 60 : 0) : 0; const gap = Number.isFinite(threshold) && subtotal < threshold ? `add ${format(threshold - subtotal)} for free delivery` : 'free delivery threshold reached'; return `<div class="lbr-order-row"><span><b>${store}</b><small>${format(subtotal)} · ${gap}</small></span><strong>${format(subtotal + fee)}</strong></div>`; }).join('')}` : ''; }
    root?.querySelectorAll('[data-price]').forEach((node) => { node.textContent = region === 'US' ? node.dataset.us ?? '' : node.dataset.in ?? ''; });
    root?.querySelectorAll('[data-buy-link]').forEach((node) => { const link = node; const us = region === 'US'; link.href = us ? link.dataset.usUrl : link.dataset.inUrl; const part = partMap.get(link.closest('[data-part-card]')?.dataset.partCard); const shop = us ? part?.us : part?.in; if (shop) link.textContent = `🛒 Buy on ${shop.store} ↗`; });
    root?.querySelectorAll('[data-part-card]').forEach((cardNode) => cardNode.classList.toggle('is-selected', Boolean(cardNode.querySelector('input')?.checked)));
    localStorage.setItem('lbr-forge-selection', JSON.stringify(parts.map((part) => part.id)));
  }
  function applyPreset(name) { const ids = presetMap[name] ?? []; inputs.forEach((input) => { input.checked = ids.includes(input.value); }); root?.querySelectorAll('[data-preset]').forEach((button) => button.classList.toggle('is-active', button.dataset.preset === name)); update(); }
  root?.querySelectorAll('[data-preset]').forEach((button) => button.addEventListener('click', () => { const name = button.dataset.preset ?? 'clear'; applyPreset(name); history.replaceState(null, '', name === 'clear' ? location.pathname : `${location.pathname}?preset=${name}`); }));
  inputs.forEach((input) => input.addEventListener('change', update)); root?.querySelector('[data-wifi]')?.addEventListener('change', update);
  window.addEventListener('lbr:region-change', (event) => { region = event.detail === 'US' ? 'US' : 'IN'; update(); }); window.addEventListener('lbr:country-change', (event) => { region = event.detail === 'US' ? 'US' : 'IN'; update(); });
  root?.querySelector('[data-copy-bom]')?.addEventListener('click', async () => { const text = selected().map((part) => { const shop = region === 'US' ? part.us : part.in; return `${part.part} — ${format(shop.price)} — ${shop.url}`; }).join('\n') || 'No parts selected'; try { await navigator.clipboard.writeText(text); if (root?.querySelector('[data-copy-status]')) root.querySelector('[data-copy-status]').textContent = 'Shopping list copied.'; } catch { if (root?.querySelector('[data-copy-status]')) root.querySelector('[data-copy-status]').textContent = 'Copy is blocked here; select the BOM text manually.'; } });
  const query = new URLSearchParams(location.search).get('preset'); let saved = null; try { saved = JSON.parse(localStorage.getItem('lbr-forge-selection') || 'null'); } catch { saved = null; }
  if (query && presetMap[query]) applyPreset(query); else if (Array.isArray(saved)) { inputs.forEach((input) => { input.checked = saved.includes(input.value); }); update(); } else applyPreset('spiderbot-good');
</script>
