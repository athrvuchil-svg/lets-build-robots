---
import components from '../data/components.json';
---

<section class="lbr-catalog" data-component-catalog><div class="lbr-catalog-head"><div><p class="lbr-kicker">23-part hardware catalog</p><h2>Find the part you actually need</h2><p class="lbr-muted-copy">Search by name, category, voltage, current, PWM, I²C address, or role. Expand a card for the electrical facts and a real vendor link.</p></div><div class="lbr-catalog-count"><strong>{components.length}</strong><span>baseline parts</span></div></div><label class="lbr-catalog-search"><span>Search hardware</span><input type="search" placeholder="Try: 3.3V, servo, 0x40, driver…" data-catalog-search /></label><div class="lbr-catalog-grid" data-catalog-grid>{components.map((part) => <article class="lbr-catalog-card" data-catalog-card data-search={`${part.part} ${part.kind} ${part.role} ${part.logicV ?? ''} ${part.signalV ?? ''} ${part.i2c ?? ''} ${part.stallA ?? ''} ${part.pwm ?? ''}`}><div class="lbr-catalog-card-top"><span class="lbr-chip">{part.role}</span><button type="button" data-expand aria-expanded="false">Details</button></div><h3>{part.part}</h3><p class="lbr-catalog-spec">{part.logicV ? `${part.logicV}V logic · ` : ''}{part.signalV ? `${part.signalV}V signal · ` : ''}{part.pwm ? `${part.pwm} PWM · ` : ''}{part.stallA ? `${part.stallA}A peak · ` : ''}{part.i2c ? `${part.i2c} · ` : ''}{part.weightG}g</p><div class="lbr-catalog-detail" hidden><p>Kind: <b>{part.kind}</b>. {part.i2c ? `I²C address ${part.i2c}. ` : ''}Check the exact board datasheet and breakout wiring before connecting.</p><div class="lbr-buy-grid"><a href={part.in.url} data-region-link data-in={part.in.url} data-us={part.us.url} target="_blank" rel="noopener noreferrer">🛒 Buy on {part.in.store} · ₹{part.in.price} ↗</a><a href={part.us.url} data-region-link data-in={part.in.url} data-us={part.us.url} target="_blank" rel="noopener noreferrer">🛒 Buy on {part.us.store} · ${part.us.price.toFixed(2)} ↗</a></div></div></article>)}</div><p class="lbr-catalog-empty" data-catalog-empty hidden>No parts match that search. Try “servo”, “ESP32”, or “5V”.</p></section>

<script>
  // @ts-nocheck
  const catalogRoot = document.querySelector('[data-component-catalog]'); const search = catalogRoot?.querySelector('[data-catalog-search]'); const cards = [...(catalogRoot?.querySelectorAll('[data-catalog-card]') ?? [])]; const empty = catalogRoot?.querySelector('[data-catalog-empty]');
  function filter() { const term = search?.value.trim().toLowerCase() ?? ''; let visible = 0; cards.forEach((card) => { const show = !term || card.dataset.search.toLowerCase().includes(term); card.hidden = !show; if (show) visible += 1; }); if (empty) empty.hidden = visible > 0; }
  search?.addEventListener('input', filter); cards.forEach((card) => card.querySelector('[data-expand]')?.addEventListener('click', () => { const detail = card.querySelector('.lbr-catalog-detail'); const button = card.querySelector('[data-expand]'); const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); button.textContent = open ? 'Details' : 'Hide details'; detail.hidden = open; }));
  function updateLinks(region) { catalogRoot?.querySelectorAll('[data-region-link]').forEach((link) => { link.href = region === 'US' ? link.dataset.us : link.dataset.in; }); } updateLinks(localStorage.getItem('lbr-region') === 'US' ? 'US' : 'IN'); window.addEventListener('lbr:region-change', (event) => updateLinks(event.detail));
</script>
