---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={{ 'lbr-sponsor-slot': true, 'lbr-sponsor-slot-compact': compact }} aria-label="Robotics shopping guidance" data-sponsor-slot="728x90">
  <div><span class="lbr-sponsor-label">LBR · SHOPPING GUIDE</span><strong>Compare real robotics parts before you buy.</strong><span class="lbr-sponsor-copy">Check Robu.in, Quartz Components, Adafruit, Pololu, and Amazon prices in The Forge.</span></div>
  <a class="lbr-button lbr-button-quiet" href="/forge/">Check part prices →</a>
</aside>
