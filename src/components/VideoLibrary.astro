---
const videos = [
  ['prLv5uwUtuY', 'Community build pick 01', 'Submitted video'], ['l2We5f35ei0', 'Community build pick 02', 'Submitted video'], ['LUVHbHbWQVk', 'Community build pick 03', 'Submitted video'], ['5nkJKNQAi8I', 'Community build pick 04', 'Submitted video'],
  ['bmoGfBe63ZA', 'Arduino Hexapod Robot That Looks Like an Ant', 'How To Mechatronics'], ['iLIIuMj-77w', 'Build a Walking Arduino Hexapod', 'Jakob Leander'], ['u-U2VmCW-e8', 'I Built an Arduino Powered Hexapod from Scratch', 'Aecert Robotics'], ['_B3gWd3A_SI', 'DIY Arduino Robot Arm with Smartphone Control', 'How To Mechatronics'], ['c6mrcNEFBoA', 'From 0 to building a robot arm with Arduino', 'Back to Engineering'], ['GDnmAI_7lOk', 'Mastering Servo Control: PCA9685 PWM Driver', 'BMonster Laboratory'], ['zxBC1ivOVfM', 'Using Servo Motors with ESP32', 'DroneBot Workshop'], ['QoNkpnpvEqc', 'I made a SUPER FAST Line Follower Robot Using PID!', 'Shyam Ravi'], ['6l9DWqb77KI', 'Simulate Arduino, ESP32, Pi Pico, STM32 with Wokwi', 'Andreas Spiess'], ['laWn7_cj434', 'Simulating Robots with Gazebo and ROS', 'Articulated Robotics'],
];
---
<section class="lbr-video-library" id="videos" data-video-library><div class="lbr-section-heading"><div><p class="lbr-kicker">14-video build shelf</p><h2>Watch the idea become hardware.</h2></div><p class="lbr-section-note">External YouTube embeds load only when you open a card.</p></div><div class="lbr-video-grid">{videos.map(([id, title, creator]) => <article class="lbr-video-card"><div class="lbr-video-thumb"><button type="button" data-video-open data-video-id={id} aria-label={`Play ${title}`}>▶</button></div><h3>{title}</h3><p>{creator}</p><iframe title={title} loading="lazy" src="about:blank" data-video-lazy={`https://www.youtube-nocookie.com/embed/${id}`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen hidden></iframe></article>)}</div></section>
<script>
  // @ts-nocheck
  document.querySelectorAll('[data-video-open]').forEach((button) => button.addEventListener('click', () => { const card = button.closest('.lbr-video-card'); const frame = card?.querySelector('[data-video-lazy]'); if (frame) { frame.hidden = false; frame.src = frame.dataset.videoLazy; } button.closest('.lbr-video-thumb')?.setAttribute('hidden', 'true'); }));
</script>
