<div class="not-content" data-leg><div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr]"><section class="lbr-card p-5"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="lbr-kicker">3D isometric pose-to-code lab</p><h2 class="text-2xl font-bold">Move a robot leg through space</h2><p class="lbr-muted-copy">Drag the foot target, change the camera, save keyframes, then export the same pose to Arduino, ESP32, or ROS 2.</p></div><button class="lbr-button lbr-button-primary" data-visualizer type="button">▶ Play Walking Animation Loop</button></div><canvas class="lbr-leg-canvas mt-5" width="700" height="420" data-canvas aria-label="Interactive 3D isometric robot leg visualizer"></canvas><div class="lbr-playground-toolbar"><span data-position>Foot Target: X +112mm · Y +0mm · Z -68mm</span><label>Camera<select data-camera><option value="iso">3D Isometric</option><option value="side">Side View</option><option value="top">Top View</option></select></label></div><div class="mt-5 grid gap-4 md:grid-cols-3">{[['Hip Turn','hip',90,30,150],['Thigh Lift','thigh',90,15,165],['Knee Bend','knee',90,20,170]].map(([label, id, value, min, max]) => <label><span class="flex justify-between text-sm font-semibold"><span>{label}</span><output data-output={id}>{value}°</output></span><input class="mt-2 w-full accent-orange-600" type="range" min={min} max={max} value={value} data-joint={id} /></label>)}</div></section><aside class="lbr-card p-5"><div class="flex items-center justify-between"><div><p class="lbr-kicker">WALK_STEPS</p><h2 class="text-2xl font-bold">Record steps</h2></div><strong data-step-count>0 Steps Saved</strong></div><div class="mt-4 flex flex-wrap gap-2"><button class="lbr-preset-button" data-save type="button">+ Save This Step</button><button class="lbr-preset-button" data-walk type="button">🐾 Load Walking Preset</button><button class="lbr-preset-button" data-reset type="button">Reset Steps</button></div><ol class="lbr-keyframe-list mt-4" data-steps><li>No steps yet. Move the sliders and save your first pose.</li></ol><div class="mt-6 border-t border-zinc-200 pt-5 dark:border-zinc-700"><div class="flex flex-wrap gap-2" role="tablist"><button class="lbr-code-tab is-active" data-code-tab="arduino" type="button">Arduino (PCA9685 C++)</button><button class="lbr-code-tab" data-code-tab="esp32" type="button">ESP32 Wi-Fi</button><button class="lbr-code-tab" data-code-tab="ros" type="button">ROS 2 Jazzy Python</button></div><pre class="lbr-code-window mt-3"><code data-code></code></pre><button class="lbr-button lbr-button-primary mt-3" data-copy type="button">📋 Copy Code</button><span class="lbr-copy-status" data-copy-status role="status"></span></div></aside></div></div>

<script>
  // @ts-nocheck
  import { registerActiveIsland, clearActiveIsland } from '../utils/islandRegistry';
  const root = document.querySelector('[data-leg]'); if (root) {
    const canvas = root.querySelector('[data-canvas]'); const ctx = canvas?.getContext('2d'); const joints = [...root.querySelectorAll('[data-joint]')]; const position = root.querySelector('[data-position]'); const camera = root.querySelector('[data-camera]'); const button = root.querySelector('[data-visualizer]'); const steps = []; let mode = 'arduino'; let running = false; let raf; let frame = 0; let target = { x: 112, y: 0, z: -68 }; let cameraMode = 'iso';
    const pose = () => joints.map((joint) => Number(joint.value)); const point = (x, y, z) => cameraMode === 'top' ? { x: 350 + x * 1.35, y: 210 + y * 1.35 } : cameraMode === 'side' ? { x: 350 + x * 1.35, y: 315 - z * 1.2 } : { x: 350 + (x - y) * .9, y: 230 + (x + y) * .35 - z * 1.05 }; const draw = () => { if (!ctx || !canvas) return; ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = '#111923'; ctx.fillRect(0, 0, canvas.width, canvas.height); ctx.strokeStyle = 'rgba(255,255,255,.1)'; for (let i = -250; i <= 250; i += 35) { const a = point(i, -250, -100), b = point(i, 250, -100); ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); const c = point(-250, i, -100), d = point(250, i, -100); ctx.beginPath(); ctx.moveTo(c.x, c.y); ctx.lineTo(d.x, d.y); ctx.stroke(); } const [hip, thigh, knee] = pose(); const a1 = (hip - 90) * Math.PI / 180; const a2 = a1 + (thigh - 90) * Math.PI / 180; const a3 = a2 + (knee - 90) * Math.PI / 180; const p0 = point(0, 0, 0); const p1 = point(35 * Math.cos(a1), 35 * Math.sin(a1), -25); const p2 = point(p1.x - 0 + 65 * Math.cos(a2), p1.y - 0 + 65 * Math.sin(a2), -42); const foot = point(target.x, target.y, target.z); const line = (a, b, color, width) => { ctx.strokeStyle = color; ctx.lineWidth = width; ctx.lineCap = 'round'; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); }; line(p0, p1, '#3b82f6', 22); line(p1, p2, '#10b981', 24); line(p2, foot, '#f59e0b', 20); ctx.fillStyle = 'rgba(0,0,0,.35)'; ctx.beginPath(); ctx.ellipse(foot.x, foot.y + 15, 34, 10, 0, 0, Math.PI*2); ctx.fill(); ctx.strokeStyle = '#a7f3d0'; ctx.setLineDash([5, 5]); ctx.strokeRect(foot.x - 12, foot.y - 12, 24, 24); ctx.setLineDash([]); [p0, p1, p2, foot].forEach((p) => { ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(p.x, p.y, 8, 0, Math.PI*2); ctx.fill(); }); const x = Math.round(target.x), y = Math.round(target.y), z = Math.round(target.z); if (position) position.textContent = `Foot Target: X ${x >= 0 ? '+' : ''}${x}mm · Y ${y >= 0 ? '+' : ''}${y}mm · Z ${z >= 0 ? '+' : ''}${z}mm`; joints.forEach((joint) => { const output = root.querySelector(`[data-output="${joint.dataset.joint}"]`); if (output) output.textContent = `${joint.value}°`; }); renderCode(); };
    const renderCode = () => { const values = steps.length ? steps : [pose()]; const rows = values.map((v) => `  {${v.join(', ')}}`).join(',\n'); const code = root.querySelector('[data-code]'); if (!code) return; if (mode === 'arduino') code.textContent = `#include <Adafruit_PWMServoDriver.h>\nAdafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(0x40);\nconst int WALK_STEPS[][3] = {\n${rows}\n};\nvoid loop(){ for(int step=0; step<${values.length}; step++){ for(int joint=0;joint<3;joint++) pwm.setPWM(joint,0,map(WALK_STEPS[step][joint],0,180,110,510)); delay(400); } }`; else if (mode === 'esp32') code.textContent = `#include <Arduino.h>\n#include <Adafruit_PWMServoDriver.h>\nAdafruit_PWMServoDriver pwm(0x40);\nconst int WALK_STEPS[][3] = {\n${rows}\n};\nvoid walkingTask(void*){ for(;;){ for(int step=0;step<${values.length};step++){ vTaskDelay(pdMS_TO_TICKS(400)); } } }\nvoid setup(){ xTaskCreatePinnedToCore(walkingTask,"Walk",4096,NULL,2,NULL,1); }\nvoid loop(){}`; else { const rosRows = values.map((v) => '[' + v.map((a) => 'math.radians(' + a + ')').join(', ') + ']').join(', '); code.textContent = `import math\nimport rclpy\nfrom sensor_msgs.msg import JointState\nWALK_STEPS = [${rosRows}]\n# ROS 2 Jazzy JointState publisher publishes these radians to /joint_states`; } };
    const renderSteps = () => { const list = root.querySelector('[data-steps]'); const count = root.querySelector('[data-step-count]'); if (count) count.textContent = `${steps.length} Steps Saved`; if (list) list.innerHTML = steps.length ? steps.map((step, index) => `<li>Step ${index + 1}: ${step.join('° · ')}°</li>`).join('') : '<li>No steps yet. Move the sliders and save your first pose.</li>'; };
    const stop = (release = false) => { running = false; if (raf) cancelAnimationFrame(raf); raf = undefined; if (button) button.textContent = '▶ Play Walking Animation Loop'; if (release) clearActiveIsland(); }; const animate = () => { if (!running) return; frame += 1; if (steps.length) { const step = steps[Math.floor(frame / 30) % steps.length]; joints.forEach((joint, index) => joint.value = String(step[index])); } draw(); raf = requestAnimationFrame(animate); };
    button?.addEventListener('click', () => { if (running) { stop(true); return; } if (!steps.length) { steps.push([90, 80, 90], [110, 100, 75], [70, 100, 110], [90, 80, 90]); renderSteps(); } running = true; frame = 0; registerActiveIsland('3d-leg-playground', () => stop(false)); button.textContent = '⏹ Stop Walking Animation'; raf = requestAnimationFrame(animate); }); camera?.addEventListener('change', () => { cameraMode = camera.value; draw(); }); joints.forEach((joint) => joint.addEventListener('input', draw)); canvas?.addEventListener('pointerdown', (event) => { const rect = canvas.getBoundingClientRect(); target.x = Math.round((event.clientX - rect.left) * canvas.width / rect.width / 1.35 - 260); target.y = Math.round((event.clientY - rect.top) * canvas.height / rect.height / 1.35 - 155); draw(); }); root.querySelector('[data-save]')?.addEventListener('click', () => { steps.push(pose()); renderSteps(); draw(); }); root.querySelector('[data-reset]')?.addEventListener('click', () => { steps.length = 0; renderSteps(); draw(); }); root.querySelector('[data-walk]')?.addEventListener('click', () => { steps.length = 0; steps.push([90,80,90],[110,100,75],[70,100,110],[90,80,90]); renderSteps(); draw(); }); root.querySelectorAll('[data-code-tab]').forEach((tab) => tab.addEventListener('click', () => { mode = tab.dataset.codeTab; root.querySelectorAll('[data-code-tab]').forEach((item) => item.classList.toggle('is-active', item === tab)); renderCode(); })); root.querySelector('[data-copy]')?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(root.querySelector('[data-code]').textContent); root.querySelector('[data-copy-status]').textContent = 'Code copied.'; } catch { root.querySelector('[data-copy-status]').textContent = 'Clipboard blocked; select the code manually.'; } }); renderSteps(); draw();
  }
</script>
