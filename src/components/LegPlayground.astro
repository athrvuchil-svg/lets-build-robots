<div class="not-content lbr-leg-lab" data-leg>
  <div class="grid gap-6 lg:grid-cols-[1.2fr_.8fr]">
    <section class="lbr-card lbr-leg-viewport-card"><div class="lbr-leg-heading"><div><p class="lbr-kicker">3D kinematics workcell</p><h2>Pose a leg. Read the mechanism.</h2><p class="lbr-muted-copy">Drag the target, change the camera, save keyframes, and watch the projected links move through a measured workspace.</p></div><button class="lbr-button lbr-button-primary" data-visualizer type="button">▶ Play walking loop</button></div><div class="lbr-leg-viewport"><canvas class="lbr-leg-canvas" width="760" height="470" data-canvas role="img" tabindex="0" aria-describedby="leg-canvas-description" aria-label="Interactive 3D isometric robot leg visualizer"></canvas><p id="leg-canvas-description" class="sr-only">A visual robot leg pose preview. Use the Hip turn, Thigh lift, and Knee bend sliders below to change the pose, or drag the target with a pointer. The canvas is a local learning model and does not control hardware.</p><div class="lbr-leg-overlay"><span class="lbr-status-dot"></span><b data-leg-status role="status" aria-live="polite">POSE EDITOR</b><small>LOCAL · 60 FPS TARGET</small></div></div><div class="lbr-playground-toolbar"><span data-position aria-live="polite">Foot target: X +112mm · Y +0mm · Z -68mm</span><label for="leg-camera">Camera<select id="leg-camera" data-camera><option value="iso">3D Isometric</option><option value="side">Side View</option><option value="top">Top View</option></select></label></div><div class="lbr-leg-controls">{[['Hip turn','hip',90,30,150],['Thigh lift','thigh',90,15,165],['Knee bend','knee',90,20,170]].map(([label, id, value, min, max]) => <label for={`leg-${id}`}><span><b>{label}</b><output data-output={id}>{value}°</output></span><input id={`leg-${id}`} type="range" min={min} max={max} value={value} data-joint={id} /></label>)}</div></section>
    <aside class="lbr-card lbr-leg-side"><div class="flex items-center justify-between"><div><p class="lbr-kicker">WALK_STEPS</p><h2 class="text-2xl font-bold">Record steps</h2></div><strong data-step-count aria-live="polite">0 steps</strong></div><div class="mt-4 flex flex-wrap gap-2"><button class="lbr-preset-button" data-save type="button">+ Save pose</button><button class="lbr-preset-button" data-walk type="button">🐾 Load gait</button><button class="lbr-preset-button" data-reset type="button">Reset</button></div><ol class="lbr-keyframe-list mt-4" data-steps aria-live="polite"><li>No steps yet. Move the sliders and save a pose.</li></ol><div class="lbr-leg-readouts"><div><span>REACH</span><b data-reach>—</b><small>mm projected</small></div><div><span>FOOT LOAD</span><b data-load>—</b><small>relative estimate</small></div><div><span>JOINTS</span><b>3 / 3</b><small>servo channels</small></div></div><div class="mt-6"><div class="lbr-code-tabs" role="group" aria-label="Code language"><button class="lbr-filter is-active" aria-pressed="true" data-code-tab="arduino" type="button">Arduino</button><button class="lbr-filter" aria-pressed="false" data-code-tab="esp32" type="button">ESP32</button><button class="lbr-filter" aria-pressed="false" data-code-tab="ros" type="button">ROS 2</button></div><pre class="lbr-code-window" data-code></pre><button class="lbr-button lbr-button-quiet mt-3" data-copy type="button">Copy code</button><span class="lbr-copy-status" data-copy-status role="status" aria-live="polite"></span></div></aside>
  </div>
</div>

<script>
  // @ts-nocheck
  import { registerActiveIsland, clearActiveIsland } from '../utils/islandRegistry';
  const root = document.querySelector('[data-leg]');
  if (root) {
    const canvas = root.querySelector('[data-canvas]'); const ctx = canvas?.getContext('2d'); const joints = [...root.querySelectorAll('[data-joint]')]; const position = root.querySelector('[data-position]'); const camera = root.querySelector('[data-camera]'); const button = root.querySelector('[data-visualizer]'); const status = root.querySelector('[data-leg-status]'); const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false; const steps = []; let mode = 'arduino'; let running = false; let raf; let frame = 0; let target = { x: 112, y: 0, z: -68 }; let cameraMode = 'iso';
    const clamp = (n, min, max) => Math.max(min, Math.min(max, n)); const pose = () => joints.map((joint) => Number(joint.value)); const point = (x, y, z) => cameraMode === 'top' ? { x: 380 + x * 1.45, y: 250 + y * 1.45 } : cameraMode === 'side' ? { x: 380 + x * 1.45, y: 360 - z * 1.45 } : { x: 380 + (x - y) * .92, y: 260 + (x + y) * .34 - z * 1.12 }; const line = (a, b, stroke, width) => { ctx.strokeStyle = stroke; ctx.lineWidth = width; ctx.lineCap = 'round'; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); }; const joint = (p, fill, radius = 10) => { ctx.fillStyle = '#08151c'; ctx.beginPath(); ctx.arc(p.x, p.y, radius + 4, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = fill; ctx.beginPath(); ctx.arc(p.x, p.y, radius, 0, Math.PI * 2); ctx.fill(); ctx.strokeStyle = '#f4f8f7'; ctx.lineWidth = 2; ctx.stroke(); };
    function draw() { if (!ctx || !canvas) return; ctx.clearRect(0, 0, canvas.width, canvas.height); const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height); gradient.addColorStop(0, '#132b3a'); gradient.addColorStop(1, '#09141b'); ctx.fillStyle = gradient; ctx.fillRect(0, 0, canvas.width, canvas.height); for (let i = -300; i <= 300; i += 35) { const a = point(i, -300, -100), b = point(i, 300, -100); line(a, b, 'rgba(69,217,194,.12)', 1); const c = point(-300, i, -100), d = point(300, i, -100); line(c, d, 'rgba(244,248,247,.07)', 1); } const [hip, thigh, knee] = pose(); const a1 = (hip - 90) * Math.PI / 180; const a2 = a1 + (thigh - 90) * Math.PI / 180; const a3 = a2 + (knee - 90) * Math.PI / 180; const p0 = point(0, 0, 0); const p1 = point(38 * Math.cos(a1), 38 * Math.sin(a1), -28); const p2 = point(p1.x - 0 + 78 * Math.cos(a2), p1.y + 78 * Math.sin(a2), -60); const foot = point(target.x, target.y, target.z); const shadow = point(target.x, target.y, -105); ctx.fillStyle = 'rgba(0,0,0,.42)'; ctx.beginPath(); ctx.ellipse(shadow.x, shadow.y + 15, 42, 12, 0, 0, Math.PI * 2); ctx.fill(); ctx.save(); ctx.globalAlpha = .25; line(p0, p1, '#45d9c2', 28); line(p1, p2, '#ff704d', 31); line(p2, foot, '#f5ca65', 27); ctx.restore(); line(p0, p1, '#2a9db2', 22); line(p1, p2, '#ff704d', 25); line(p2, foot, '#f5ca65', 21); line(p0, p1, 'rgba(244,248,247,.35)', 2); line(p1, p2, 'rgba(244,248,247,.35)', 2); line(p2, foot, 'rgba(244,248,247,.35)', 2); joint(p0, '#45d9c2', 12); joint(p1, '#ff704d', 11); joint(p2, '#f5ca65', 11); joint(foot, '#8be0b0', 8); ctx.strokeStyle = '#f5ca65'; ctx.setLineDash([6, 6]); ctx.strokeRect(foot.x - 16, foot.y - 16, 32, 32); ctx.setLineDash([]); ctx.fillStyle = '#f4f8f7'; ctx.font = '800 11px JetBrains Mono, monospace'; ctx.fillText('KINEMATICS / LIVE POSE', 20, 28); ctx.fillStyle = '#8ca2ac'; ctx.font = '600 10px JetBrains Mono, monospace'; ctx.fillText(`CAMERA ${cameraMode.toUpperCase()} · FRAME ${String(frame).padStart(4, '0')}`, 20, 47); const reach = Math.round(Math.hypot(target.x, target.y, target.z)); const load = Math.max(0, Math.round((Math.abs(thigh - 90) + Math.abs(knee - 90)) * .42)); root.querySelector('[data-reach]').textContent = `${reach} mm`; root.querySelector('[data-load]').textContent = `${load}%`; if (position) position.textContent = `Foot target: X ${target.x >= 0 ? '+' : ''}${Math.round(target.x)}mm · Y ${target.y >= 0 ? '+' : ''}${Math.round(target.y)}mm · Z ${Math.round(target.z)}mm`; }
    const renderCode = () => { const values = steps.length ? steps : [pose()]; const rows = values.map((v) => `  {${v.join(', ')}}`).join(',\n'); const code = root.querySelector('[data-code]'); if (!code) return; if (mode === 'arduino') code.textContent = `#include <Adafruit_PWMServoDriver.h>\nAdafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(0x40);\nconst int WALK_STEPS[][3] = {\n${rows}\n};\nvoid loop(){ for(int step=0; step<${values.length}; step++){ for(int joint=0;joint<3;joint++) pwm.setPWM(joint,0,map(WALK_STEPS[step][joint],0,180,110,510)); delay(400); } }`; else if (mode === 'esp32') code.textContent = `#include <Arduino.h>\n#include <Adafruit_PWMServoDriver.h>\nAdafruit_PWMServoDriver pwm(0x40);\nconst int WALK_STEPS[][3] = {\n${rows}\n};\nvoid walkingTask(void*){ for(;;){ for(int step=0;step<${values.length};step++){ vTaskDelay(pdMS_TO_TICKS(400)); } } }\nvoid setup(){ xTaskCreatePinnedToCore(walkingTask,"Walk",4096,NULL,2,NULL,1); }\nvoid loop(){}`; else { const rosRows = values.map((v) => '[' + v.map((a) => 'math.radians(' + a + ')').join(', ') + ']').join(', '); code.textContent = `import math\nimport rclpy\nfrom sensor_msgs.msg import JointState\nWALK_STEPS = [${rosRows}]\n# ROS 2 Jazzy JointState publisher publishes these radians to /joint_states`; } };
    const renderSteps = () => { const list = root.querySelector('[data-steps]'); const count = root.querySelector('[data-step-count]'); if (count) count.textContent = `${steps.length} ${steps.length === 1 ? 'step' : 'steps'}`; if (list) list.innerHTML = steps.length ? steps.map((step, index) => `<li><b>${String(index + 1).padStart(2, '0')}</b> ${step.join('° · ')}°</li>`).join('') : '<li>No steps yet. Move the sliders and save a pose.</li>'; renderCode(); };
    const stop = (release = false) => { running = false; if (raf) cancelAnimationFrame(raf); raf = undefined; if (button) button.textContent = '▶ Play walking loop'; if (status) status.textContent = 'POSE EDITOR'; if (release) clearActiveIsland(); }; const animate = (time) => { if (!running) return; frame += 1; if (steps.length) { const step = steps[Math.floor(frame / 30) % steps.length]; joints.forEach((jointNode, index) => jointNode.value = String(step[index])); } else { joints[0].value = String(90 + Math.round(Math.sin(frame * .06) * 12)); joints[1].value = String(90 + Math.round(Math.sin(frame * .06 + 1.4) * 16)); joints[2].value = String(90 + Math.round(Math.sin(frame * .06 + 2.3) * 20)); } draw(); raf = requestAnimationFrame(animate); };
    button?.addEventListener('click', () => { if (running) { stop(true); return; } if (!steps.length) { steps.push([90,80,90],[110,100,75],[70,100,110],[90,80,90]); renderSteps(); } if (reducedMotion) { draw(); status.textContent = 'POSE PREVIEW · animation reduced'; return; } running = true; frame = 0; status.textContent = 'WALK LOOP · RUNNING'; registerActiveIsland('3d-leg-playground', () => stop(false)); button.textContent = '■ Stop walking loop'; raf = requestAnimationFrame(animate); }); camera?.addEventListener('change', () => { cameraMode = camera.value; draw(); }); joints.forEach((jointNode) => jointNode.addEventListener('input', () => { const output = root.querySelector(`[data-output="${jointNode.dataset.joint}"]`); if (output) output.textContent = `${jointNode.value}°`; draw(); })); let dragging = false; canvas?.addEventListener('pointerdown', (event) => { dragging = true; canvas.setPointerCapture?.(event.pointerId); const rect = canvas.getBoundingClientRect(); target.x = Math.round((event.clientX - rect.left) * canvas.width / rect.width / 1.45 - 260); target.y = Math.round((event.clientY - rect.top) * canvas.height / rect.height / 1.45 - 155); draw(); }); canvas?.addEventListener('pointermove', (event) => { if (!dragging) return; const rect = canvas.getBoundingClientRect(); target.x = clamp(Math.round((event.clientX - rect.left) * canvas.width / rect.width / 1.45 - 260), -170, 190); target.y = clamp(Math.round((event.clientY - rect.top) * canvas.height / rect.height / 1.45 - 155), -150, 150); draw(); }); canvas?.addEventListener('pointerup', (event) => { dragging = false; canvas.releasePointerCapture?.(event.pointerId); }); root.querySelector('[data-save]')?.addEventListener('click', () => { steps.push(pose()); renderSteps(); draw(); }); root.querySelector('[data-reset]')?.addEventListener('click', () => { steps.length = 0; renderSteps(); draw(); }); root.querySelector('[data-walk]')?.addEventListener('click', () => { steps.length = 0; steps.push([90,80,90],[110,100,75],[70,100,110],[90,80,90]); renderSteps(); draw(); }); root.querySelectorAll('[data-code-tab]').forEach((tab) => tab.addEventListener('click', () => { mode = tab.dataset.codeTab; root.querySelectorAll('[data-code-tab]').forEach((item) => { const active = item === tab; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); }); renderCode(); })); root.querySelector('[data-copy]')?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(root.querySelector('[data-code]').textContent); root.querySelector('[data-copy-status]').textContent = 'Code copied.'; } catch { root.querySelector('[data-copy-status]').textContent = 'Clipboard blocked; select the code manually.'; } }); renderSteps(); draw();
  }
</script>
