<div class="not-content" data-leg>
  <div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr]">
    <section class="lbr-card p-5"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="lbr-kicker">3-DOF pose-to-code lab</p><h2 class="text-2xl font-bold">Move a robot leg</h2><p class="lbr-muted-copy">The canvas uses a simple forward-kinematics teaching model: Coxa 35mm, Femur 65mm, Tibia 95mm.</p></div><button class="lbr-button lbr-button-primary" data-visualizer>▶ Start Interactive Leg Visualizer</button></div><canvas class="lbr-leg-canvas mt-5" width="700" height="420" data-canvas aria-label="Interactive robot leg visualizer"></canvas><div class="lbr-position-readout" data-position>Foot Position in Space: X: +112mm, Y: +0mm, Z: -68mm</div><div class="mt-5 grid gap-4 md:grid-cols-3">{[['Hip Turn','hip',90,30,150],['Thigh Lift','thigh',90,15,165],['Knee Bend','knee',90,20,170]].map(([label, id, value, min, max]) => <label><span class="flex justify-between text-sm font-semibold"><span>{label}</span><output data-output={id}>{value}°</output></span><input class="mt-2 w-full accent-orange-600" type="range" min={min} max={max} value={value} data-joint={id} /></label>)}</div></section>
    <aside class="lbr-card p-5"><div class="flex items-center justify-between"><div><p class="lbr-kicker">Walking keyframes</p><h2 class="text-2xl font-bold">Record steps</h2></div><strong data-step-count>0 Steps Saved</strong></div><div class="mt-4 flex flex-wrap gap-2"><button class="lbr-preset-button" data-save>+ Save This Step</button><button class="lbr-preset-button" data-walk>🐾 Load Walking Preset</button><button class="lbr-preset-button" data-reset>Reset Steps</button></div><ol class="lbr-keyframe-list mt-4" data-steps><li>No steps yet. Move the sliders and save your first pose.</li></ol><div class="mt-6 border-t border-zinc-200 pt-5 dark:border-zinc-700"><div class="flex flex-wrap gap-2" role="tablist"><button class="lbr-code-tab is-active" data-code-tab="arduino">Arduino (Easy)</button><button class="lbr-code-tab" data-code-tab="esp32">ESP32 Wi-Fi</button><button class="lbr-code-tab" data-code-tab="ros">ROS 2 Python</button></div><pre class="lbr-code-window mt-3"><code data-code></code></pre><button class="lbr-button lbr-button-primary mt-3" data-copy>📋 Copy Code</button></div></aside>
  </div>
</div>

<script>
  import { registerActiveIsland, clearActiveIsland } from '../utils/islandRegistry';
  type Point = { x: number; y: number }; type Step = [number, number, number];
  const root = document.querySelector('[data-leg]'); const canvas = root?.querySelector<HTMLCanvasElement>('[data-canvas]'); const ctx = canvas?.getContext('2d'); const joints = [...(root?.querySelectorAll<HTMLInputElement>('[data-joint]') ?? [])]; const position = root?.querySelector('[data-position]'); const steps: Step[] = []; let mode: 'arduino' | 'esp32' | 'ros' = 'arduino'; let frame: number | undefined; let running = false;
  const pose = (): Step => [Number(joints[0]?.value ?? 90), Number(joints[1]?.value ?? 90), Number(joints[2]?.value ?? 90)];
  function draw() { if (!ctx || !canvas) return; const [hip, thigh, knee] = pose(); const w = canvas.width; const h = canvas.height; ctx.clearRect(0, 0, w, h); ctx.fillStyle = '#0f141c'; ctx.fillRect(0, 0, w, h); ctx.strokeStyle = 'rgba(255,255,255,.08)'; for (let x = 0; x < w; x += 35) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); } for (let y = 0; y < h; y += 35) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); } const origin: Point = { x: 350, y: 210 }; const a1 = (hip - 90) * Math.PI / 180; const a2 = a1 + (thigh - 90) * Math.PI / 180; const a3 = a2 + (knee - 90) * Math.PI / 180; const p1: Point = { x: origin.x + 55 * Math.cos(a1), y: origin.y + 55 * Math.sin(a1) }; const p2: Point = { x: p1.x + 110 * Math.cos(a2), y: p1.y + 110 * Math.sin(a2) }; const p3: Point = { x: p2.x + 145 * Math.cos(a3), y: p2.y + 145 * Math.sin(a3) }; const line = (from: Point, to: Point, color: string, width: number) => { ctx.strokeStyle = color; ctx.lineWidth = width; ctx.lineCap = 'round'; ctx.beginPath(); ctx.moveTo(from.x, from.y); ctx.lineTo(to.x, to.y); ctx.stroke(); }; line(origin, p1, '#3b82f6', 22); line(p1, p2, '#10b981', 24); line(p2, p3, '#f59e0b', 24); [origin, p1, p2, p3].forEach((point: Point) => { ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(point.x, point.y, 9, 0, Math.PI * 2); ctx.fill(); }); const x = Math.round((p3.x - origin.x) * .72); const y = Math.round((p3.y - origin.y) * .72); const z = Math.round(-68 + (170 - knee) * .45); if (position) position.textContent = `Foot Position in Space: X: ${x >= 0 ? '+' : ''}${x}mm, Y: ${y >= 0 ? '+' : ''}${y}mm, Z: ${z >= 0 ? '+' : ''}${z}mm`; joints.forEach((joint) => { const out = root?.querySelector(`[data-output="${joint.dataset.joint}"]`); if (out) out.textContent = `${joint.value}°`; }); renderCode(); }
  function renderCode() { const values = steps.length ? steps : [pose()]; const code = root?.querySelector('[data-code]'); if (!code) return; const rows = values.map((v) => `  {${v.join(', ')}}`).join(',\n'); if (mode === 'arduino') code.textContent = `#include <Adafruit_PWMServoDriver.h>\nAdafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(0x40);\nconst int WALK_STEPS[][3] = {\n${rows}\n};\nconst int STEP_COUNT = ${values.length};\nvoid loop() {\n  for (int step = 0; step < STEP_COUNT; step++) {\n    for (int joint = 0; joint < 3; joint++) pwm.setPWM(joint, 0, map(WALK_STEPS[step][joint], 0, 180, 110, 510));\n    delay(400);\n  }\n}`; else if (mode === 'esp32') code.textContent = `#include <Arduino.h>\n#include <Wire.h>\n#include <Adafruit_PWMServoDriver.h>\nAdafruit_PWMServoDriver pwm(0x40);\nconst int WALK_STEPS[][3] = {\n${rows}\n};\nconst int STEP_COUNT = ${values.length};\nvoid walkingTask(void*) {\n  for (;;) {\n    for (int step = 0; step < STEP_COUNT; step++) {\n      for (int joint = 0; joint < 3; joint++) pwm.setPWM(joint, 0, map(WALK_STEPS[step][joint], 0, 180, 110, 510));\n      vTaskDelay(pdMS_TO_TICKS(400));\n    }\n  }\n}\nvoid setup() { Wire.begin(21, 22); pwm.begin(); pwm.setPWMFreq(50); xTaskCreatePinnedToCore(walkingTask, "Walk", 4096, NULL, 2, NULL, 1); }\nvoid loop() {}`; else code.textContent = `import math\nimport rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\n\nWALK_STEPS = [${values.map((v) => `[${v.map((angle) => `math.radians(${angle})`).join(', ')}]`).join(', ')}]\n\nclass Walker(Node):\n    def __init__(self):\n        super().__init__('lbr_walker')\n        self.pub = self.create_publisher(JointState, '/joint_states', 10)\n        self.index = 0\n        self.timer = self.create_timer(0.4, self.publish_step)\n    def publish_step(self):\n        msg = JointState()\n        msg.name = ['hip_joint', 'thigh_joint', 'knee_joint']\n        msg.position = WALK_STEPS[self.index]\n        self.pub.publish(msg)\n        self.index = (self.index + 1) % len(WALK_STEPS)\n\nrclpy.init(); node = Walker(); rclpy.spin(node); node.destroy_node(); rclpy.shutdown()`; }
  function stop() { running = false; if (frame) cancelAnimationFrame(frame); frame = undefined; const button = root?.querySelector('[data-visualizer]'); if (button) button.textContent = '▶ Start Interactive Leg Visualizer'; }
  function animate() { if (!running) return; draw(); frame = requestAnimationFrame(animate); }
  joints.forEach((joint) => joint.addEventListener('input', draw)); root?.querySelector('[data-visualizer]')?.addEventListener('click', () => { if (running) { stop(); clearActiveIsland(); return; } running = true; registerActiveIsland('3d-leg-playground', stop); const button = root?.querySelector('[data-visualizer]'); if (button) button.textContent = '⏹ Stop Interactive Leg Visualizer'; animate(); });
  root?.querySelector('[data-save]')?.addEventListener('click', () => { steps.push(pose()); renderSteps(); renderCode(); }); root?.querySelector('[data-reset]')?.addEventListener('click', () => { steps.length = 0; renderSteps(); renderCode(); }); root?.querySelector('[data-walk]')?.addEventListener('click', () => { steps.length = 0; const walkingPreset: Step[] = [[90,80,90],[110,100,75],[70,100,110],[90,80,90]]; walkingPreset.forEach((item) => steps.push(item)); renderSteps(); renderCode(); });
  function renderSteps() { const list = root?.querySelector('[data-steps]'); const count = root?.querySelector('[data-step-count]'); if (count) count.textContent = `${steps.length} Steps Saved`; if (list) list.innerHTML = steps.length ? steps.map((step, index) => `<li>Step ${index + 1}: Hip ${step[0]}° · Thigh ${step[1]}° · Knee ${step[2]}°</li>`).join('') : '<li>No steps yet. Move the sliders and save your first pose.</li>'; }
  root?.querySelectorAll<HTMLButtonElement>('[data-code-tab]').forEach((tab) => tab.addEventListener('click', () => { const next = tab.dataset.codeTab; if (next === 'arduino' || next === 'esp32' || next === 'ros') mode = next; root.querySelectorAll('[data-code-tab]').forEach((item) => item.classList.toggle('is-active', item === tab)); renderCode(); })); root?.querySelector('[data-copy]')?.addEventListener('click', async () => { await navigator.clipboard?.writeText(root?.querySelector('[data-code]')?.textContent ?? ''); }); renderSteps(); draw();
</script>
