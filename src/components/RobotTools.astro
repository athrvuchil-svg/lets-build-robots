<section class="lbr-tools" data-tools><div class="lbr-section-heading"><div><p class="lbr-kicker">Coders-Hub-style engineering desk</p><h2>Six calculators with instant feedback.</h2></div><p class="lbr-section-note">Client-side formulas only. The outputs are estimates for learning, not a substitute for a datasheet.</p></div><div class="lbr-tool-grid">
  <article class="lbr-tool-card" id="battery"><h3>🔋 Battery runtime &amp; LiPo C-rating</h3><div class="lbr-tool-fields"><label>Capacity (mAh)<input type="number" value="2200" min="100" data-battery-cap></label><label>Cells<select data-battery-cells><option value="2">2S · 7.4V</option><option value="3">3S · 11.1V</option><option value="4">4S · 14.8V</option></select></label><label>Discharge C<input type="number" value="30" min="1" data-battery-c></label><label>Average draw (A)<input type="number" value="2" min="0.1" step="0.1" data-battery-draw></label><label>Peak stall (A)<input type="number" value="9.6" min="0" step="0.1" data-battery-stall></label></div><output class="lbr-tool-output" data-battery-output></output></article>
  <article class="lbr-tool-card" id="torque"><h3>🦾 Servo torque &amp; arm lift</h3><div class="lbr-tool-fields"><label>Arm length (cm)<input type="number" value="10" min="1" data-torque-arm></label><label>Payload (g)<input type="number" value="100" min="0" data-torque-payload></label><label>Link weight (g)<input type="number" value="50" min="0" data-torque-link></label><label>Safety margin<select data-torque-margin><option value="1.5">1.5×</option><option value="2">2×</option></select></label></div><output class="lbr-tool-output" data-torque-output></output></article>
  <article class="lbr-tool-card" id="divider"><h3>⚡ Logic divider &amp; LED resistor</h3><div class="lbr-tool-fields"><label>Source voltage<input type="number" value="5" step="0.1" data-divider-source></label><label>Target pin<input type="number" value="3.3" step="0.1" data-divider-target></label><label>R1 (kΩ)<input type="number" value="10" data-divider-r1></label></div><div class="lbr-resistor-schematic" aria-label="Voltage divider schematic"><span>5V</span><i>R1</i><span>OUT</span><i>R2</i><span>GND</span></div><output class="lbr-tool-output" data-divider-output></output></article>
  <article class="lbr-tool-card" id="stepper"><h3>⚙️ Stepper steps/mm &amp; RPM</h3><div class="lbr-tool-fields"><label>Step angle<select data-stepper-angle><option value="1.8">1.8°</option><option value="0.9">0.9°</option></select></label><label>Microstepping<select data-stepper-micro><option value="1">1/1</option><option value="2">1/2</option><option value="4">1/4</option><option value="8">1/8</option><option value="16" selected>1/16</option><option value="32">1/32</option></select></label><label>Drive geometry<select data-stepper-mode><option value="belt">GT2 belt · 2mm pitch · 20T</option><option value="lead">Leadscrew · 8mm pitch</option></select></label></div><output class="lbr-tool-output" data-stepper-output></output></article>
  <article class="lbr-tool-card" id="i2c"><h3>🔌 I²C address scanner</h3><div class="lbr-check-grid">{['PCA9685 · 0x40','INA219 · 0x40','MPU6050 · 0x68','DS3231 · 0x68','BME280 · 0x76','SSD1306 · 0x3C','VL53L0X · 0x29'].map((device) => <label><input type="checkbox" checked data-i2c-device={device.split(' · ')[1]} data-i2c-name={device.split(' · ')[0]} /> {device}</label>)}</div><div class="lbr-address-grid" data-i2c-grid></div><output class="lbr-tool-output" data-i2c-output></output></article>
  <article class="lbr-tool-card" id="wheel"><h3>🛞 Wheel speed &amp; incline</h3><div class="lbr-tool-fields"><label>Motor RPM<input type="number" value="300" data-wheel-rpm></label><label>Wheel diameter (mm)<input type="number" value="65" data-wheel-diameter></label><label>Robot weight (kg)<input type="number" value="1.5" step="0.1" data-wheel-weight></label><label>Incline (°)<input type="number" value="10" min="0" max="30" data-wheel-incline></label></div><output class="lbr-tool-output" data-wheel-output></output></article>
</div></section>

<script>
  // @ts-nocheck
  import { batteryRuntime, servoTorque, divider, stepper, i2cScan, wheelSpeed } from '../utils/robotMath.mjs';
  const root = document.querySelector('[data-tools]'); if (root) {
    const q = (selector) => root.querySelector(selector); const out = (selector, text) => { const node = q(selector); if (node) node.innerHTML = text; };
    const renderBattery = () => { const result = batteryRuntime({ capacityMah: Number(q('[data-battery-cap]').value), cells: Number(q('[data-battery-cells]').value), cRating: Number(q('[data-battery-c]').value), drawA: Number(q('[data-battery-draw]').value), stallA: Number(q('[data-battery-stall]').value) }); out('[data-battery-output]', `<strong>${result.pass ? '✅ C-rating passes' : '🛑 C-rating is short'}</strong><span>Safe continuous ${result.safeContinuousA.toFixed(1)}A · estimated runtime ${result.runtimeMin.toFixed(0)} min · buzzer cutoff ${result.cutoffV.toFixed(1)}V</span>`); };
    const renderTorque = () => { const result = servoTorque({ armCm: Number(q('[data-torque-arm]').value), payloadG: Number(q('[data-torque-payload]').value), linkG: Number(q('[data-torque-link]').value), margin: Number(q('[data-torque-margin]').value) }); const cards = [['SG90', 1.8], ['MG90S', 2.2], ['MG996R', 10], ['DS3218', 20]]; out('[data-torque-output]', `<strong>Required ${result.kgCm.toFixed(2)} kg·cm · ${result.Nm.toFixed(2)} N·m</strong><span>${cards.map(([name, limit]) => `${result.kgCm <= limit ? '✅' : '🛑'} ${name} ${limit} kg·cm`).join(' · ')}</span>`); };
    const renderDivider = () => { const result = divider({ sourceV: Number(q('[data-divider-source]').value), targetV: Number(q('[data-divider-target]').value), r1K: Number(q('[data-divider-r1]').value) }); out('[data-divider-output]', `<strong>R2 ${result.r2K.toFixed(1)} kΩ · output ${result.actualV.toFixed(2)}V</strong><span>Use a TXS0108E for I²C/SPI above roughly 100kHz or for bidirectional buses.</span>`); };
    const renderStepper = () => { const belt = q('[data-stepper-mode]').value === 'belt'; const result = stepper({ angle: Number(q('[data-stepper-angle]').value), microstep: Number(q('[data-stepper-micro]').value), pitch: belt ? 2 : 8, teeth: belt ? 20 : 1, leadscrew: !belt }); out('[data-stepper-output]', `<strong>${result.stepsPerMm.toFixed(1)} steps/mm</strong><span>${result.stepsPerRev.toFixed(0)} microsteps/rev · A4988 Vref learning target ≈ ${result.vrefA.toFixed(2)}V for 1.5A motor current.</span>`); };
    const renderI2c = () => { const selected = [...root.querySelectorAll('[data-i2c-device]:checked')].map((node) => ({ address: node.dataset.i2cDevice, name: node.dataset.i2cName })); const result = i2cScan(selected); const grid = q('[data-i2c-grid]'); if (grid) grid.innerHTML = Array.from({ length: 128 }, (_, index) => { const address = `0x${index.toString(16).padStart(2, '0').toUpperCase()}`; const count = result.counts[address] || 0; return `<span class="${count > 1 ? 'is-collision' : count ? 'is-used' : ''}">${address}</span>`; }).join(''); out('[data-i2c-output]', result.collisions.length ? `<strong>🛑 Collision: ${result.collisions.join(', ')}</strong><span>Change the MPU-6050 AD0 pad to 0x69 or move INA219 A0/A1 so every device has one address.</span>` : `<strong>✅ ${selected.length} device addresses are unique</strong><span>Green cells are present on the simulated bus.</span>`); };
    const renderWheel = () => { const result = wheelSpeed({ rpm: Number(q('[data-wheel-rpm]').value), diameterMm: Number(q('[data-wheel-diameter]').value), weightKg: Number(q('[data-wheel-weight]').value), inclineDeg: Number(q('[data-wheel-incline]').value) }); out('[data-wheel-output]', `<strong>${result.speedMps.toFixed(2)} m/s · ${result.speedKmh.toFixed(2)} km/h</strong><span>Required wheel torque ${result.torqueNm.toFixed(2)} N·m · suggested ${result.driver}</span>`); };
    const renderAll = () => { renderBattery(); renderTorque(); renderDivider(); renderStepper(); renderI2c(); renderWheel(); }; root.querySelectorAll('input,select').forEach((field) => field.addEventListener('input', renderAll)); root.querySelectorAll('select').forEach((field) => field.addEventListener('change', renderAll)); renderAll();
  }
</script>
