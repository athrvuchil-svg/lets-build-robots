---
const profiles = [
  { id: 'spiderbot', number: '01', icon: '🐾', name: '4-Legged Spiderbot', copy: 'Twelve servos, a PCA9685, and a power test that makes brownout risk visible.', github: 'https://github.com/adafruit/Adafruit-PWM-Servo-Driver-Library', videos: ['bmoGfBe63ZA', 'iLIIuMj-77w'], preset: 'spiderbot-good' },
  { id: 'arm', number: '02', icon: '🦾', name: '6-DOF Desktop Arm', copy: 'Click the workbench to set a target and watch a 2D inverse-kinematics pick-and-place.', github: 'https://github.com/ros-controls/ros2_control', videos: ['_B3gWd3A_SI', 'c6mrcNEFBoA'], preset: 'spiderbot-good' },
  { id: 'line', number: '03', icon: '🏎️', name: 'PID Line Follower', copy: 'Tune Kp and Kd, drop an obstacle, and see why a fast rover can fishtail.', github: 'https://github.com/espressif/arduino-esp32', videos: ['QoNkpnpvEqc'], preset: 'conveyor' },
  { id: 'radar', number: '04', icon: '📡', name: 'Radar + Conveyor Sorter', copy: 'Sweep a sonar beam, move packages, and compare a cool MOSFET driver with L298N heat.', github: 'https://github.com/jrowberg/i2cdevlib', videos: ['6l9DWqb77KI', 'GDnmAI_7lOk'], preset: 'conveyor' },
];
---

<section class="lbr-card lbr-sim-workspace" data-local-simulator data-sim-name="robot-lab">
  <div class="lbr-workspace-heading"><div><p class="lbr-kicker">Robot Lab · local 60FPS canvas</p><h2>Run the loop, then inspect the wiring.</h2><p class="lbr-muted-copy">Everything here is deterministic and browser-local. The canvas is not a physics engine and it cannot control a physical robot.</p></div><span class="lbr-local-badge">NO ACCOUNT · NO DOWNLOAD</span></div>
  <div class="lbr-sim-layout lbr-real-sim-layout">
    <div class="lbr-profile-list" role="tablist" aria-label="Robot simulator profiles">{profiles.map((profile, index) => <button class:list={{ 'is-selected': index === 0 }} class="lbr-profile-button" type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-profile={profile.id}><span class="lbr-profile-number">{profile.number}</span><span><strong>{profile.icon} {profile.name}</strong><small>{profile.copy}</small></span></button>)}</div>
    <div class="lbr-sim-main"><div class="lbr-inner-tabs" role="tablist" aria-label="Simulator details"><button class="lbr-inner-tab is-active" data-inner-tab="visual" type="button">🎮 Live 60FPS Visual Sim</button><button class="lbr-inner-tab" data-inner-tab="video" type="button">🎥 Watch Build Guide</button><button class="lbr-inner-tab" data-inner-tab="wiring" type="button">🔌 Wiring, Code &amp; Buy Parts</button></div><div class="lbr-sim-stage" data-sim-stage><canvas width="760" height="430" data-sim-canvas aria-label="Animated robotics simulator"></canvas><div class="lbr-sim-alert" data-sim-alert hidden></div><span class="lbr-canvas-hint" data-canvas-hint>Press Play, then click the canvas to set a target.</span></div><div class="lbr-sim-detail-panel" data-detail-panel hidden></div></div>
    <div class="lbr-sim-console"><div class="lbr-console-top"><span data-sim-status>Ready · choose a profile</span><span class="font-mono" data-sim-tick>frame 0000</span></div><p data-sim-description>{profiles[0].copy}</p><div data-sim-controls></div><div class="lbr-sim-actions"><button class="lbr-button lbr-button-primary" type="button" data-sim-play>▶ Play 60FPS Sim</button><button class="lbr-button lbr-button-quiet" type="button" data-sim-stop>⏹ Stop and release</button></div><div class="lbr-log-wrap"><div class="lbr-log-heading"><strong>Live event log</strong><span class="eng-only-inline">requestAnimationFrame stream</span></div><ul class="lbr-run-log" data-run-log><li>Ready · no simulator is running</li></ul></div><p class="eng-only lbr-engineer-note">Only this canvas owns an animation frame. Starting another profile releases the previous island through window.__LBR_ACTIVE_TOOL__.</p></div>
  </div>
</section>

<script>
  // @ts-nocheck
  import { registerActiveIsland, clearActiveIsland } from '../utils/islandRegistry';
  const root = document.querySelector('[data-local-simulator]');
  if (root) {
    const profiles = {
      spiderbot: { name: '4-Legged Spiderbot', copy: 'Twelve servos, a PCA9685, and a power test that makes brownout risk visible.', github: 'https://github.com/adafruit/Adafruit-PWM-Servo-Driver-Library', videos: ['bmoGfBe63ZA', 'iLIIuMj-77w'] },
      arm: { name: '6-DOF Desktop Arm', copy: 'Click the workbench to set a target and watch a 2D inverse-kinematics pick-and-place.', github: 'https://github.com/ros-controls/ros2_control', videos: ['_B3gWd3A_SI', 'c6mrcNEFBoA'] },
      line: { name: 'PID Line Follower', copy: 'Tune Kp and Kd, drop an obstacle, and see why a fast rover can fishtail.', github: 'https://github.com/espressif/arduino-esp32', videos: ['QoNkpnpvEqc'] },
      radar: { name: 'Radar + Conveyor Sorter', copy: 'Sweep a sonar beam, move packages, and compare a cool MOSFET driver with L298N heat.', github: 'https://github.com/jrowberg/i2cdevlib', videos: ['6l9DWqb77KI', 'GDnmAI_7lOk'] },
    };
    const buttons = [...root.querySelectorAll('[data-profile]')]; const canvas = root.querySelector('[data-sim-canvas]'); const ctx = canvas?.getContext('2d'); const stage = root.querySelector('[data-sim-stage]'); const controls = root.querySelector('[data-sim-controls]'); const detail = root.querySelector('[data-detail-panel]'); const status = root.querySelector('[data-sim-status]'); const tickLabel = root.querySelector('[data-sim-tick]'); const desc = root.querySelector('[data-sim-description]'); const log = root.querySelector('[data-run-log]'); const play = root.querySelector('[data-sim-play]'); const stop = root.querySelector('[data-sim-stop]'); const alertBox = root.querySelector('[data-sim-alert]'); const hint = root.querySelector('[data-canvas-hint]');
    let selected = 'spiderbot'; let running = false; let raf; let frame = 0; let last = 0; let mode = 'visual'; let obstacle = null; let armTarget = { x: 570, y: 245 }; let radarDistance = 90; let spiderPower = 'good'; let gait = 'ripple'; let direction = 1; let draggingCanvas = false; let state = { speed: 6, kp: 1.2, kd: 0.4, rpm: 160, driver: 'mosfet', pin: 'adc1', payload: 150 };
    const addLog = (text) => { if (!log) return; const li = document.createElement('li'); li.textContent = text; log.prepend(li); while (log.children.length > 6) log.lastElementChild?.remove(); };
    const val = (key, fallback) => Number(root.querySelector(`[data-control="${key}"]`)?.value ?? fallback);
    function drawGrid() { if (!ctx || !canvas) return; ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = '#111923'; ctx.fillRect(0, 0, canvas.width, canvas.height); ctx.strokeStyle = 'rgba(255,255,255,.09)'; ctx.lineWidth = 1; for (let x = 0; x < canvas.width; x += 32) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); } for (let y = 0; y < canvas.height; y += 32) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); } }
    function label(text, x, y, color = '#d8e2e6') { if (!ctx) return; ctx.fillStyle = color; ctx.font = '12px JetBrains Mono, monospace'; ctx.fillText(text, x, y); }
    function drawSpider(t) { drawGrid(); if (!ctx) return; const cx = 380, cy = 220, bad = spiderPower === 'bad'; ctx.save(); ctx.translate(cx, cy); ctx.rotate(Math.sin(t * .003) * .04); ctx.fillStyle = '#263b48'; ctx.strokeStyle = '#13b9c7'; ctx.lineWidth = 4; ctx.beginPath(); ctx.ellipse(0, 0, 74, 48, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke(); const legs = [[-55,-24,-125,-80,-170,-42], [55,-24,125,-80,170,-42], [-55,24,-125,80,-170,42], [55,24,125,80,170,42]]; legs.forEach((leg, i) => { const phase = t * .006 * (val('speed', 6) / 6) + i * (Math.PI / 2) + (gait === 'trot' ? (i % 2) * Math.PI : 0); const lift = Math.sin(phase) * 16; const jitter = bad ? Math.sin(t * .09 + i * 4) * 18 : 0; ctx.strokeStyle = bad ? '#ef4444' : i % 2 ? '#f59e0b' : '#10b981'; ctx.lineWidth = 10; ctx.beginPath(); ctx.moveTo(leg[0], leg[1]); ctx.lineTo(leg[2] + jitter, leg[3] + lift); ctx.lineTo(leg[4] + jitter, leg[5] + lift); ctx.stroke(); ctx.fillStyle = bad ? '#ef4444' : '#8ff5ce'; ctx.beginPath(); ctx.arc(leg[4] + jitter, leg[5] + lift, 7, 0, Math.PI * 2); ctx.fill(); }); ctx.restore(); label(`12 servos · ${gait.toUpperCase()} · ${bad ? 'BROWNOUT RISK' : 'POWER RAIL OK'}`, 24, 28, bad ? '#ff7b67' : '#8ff5ce'); label(`V ${bad ? (2.9 + Math.abs(Math.sin(t * .02)) * .5).toFixed(2) : '5.00'} · A ${(bad ? 2.2 : 4.8 + Math.abs(Math.sin(t * .005)) * 3).toFixed(1)}`, 24, 50); ctx.strokeStyle = bad ? '#ef4444' : '#13b9c7'; ctx.beginPath(); for (let x = 24; x < 260; x += 4) { const y = 84 + Math.sin(x * .13 + t * .02) * (bad ? 22 : 10); if (x === 24) ctx.moveTo(x, y); else ctx.lineTo(x, y); } ctx.stroke(); }
    function drawArm(t) { drawGrid(); if (!ctx) return; ctx.fillStyle = '#5b4638'; ctx.fillRect(75, 330, 610, 18); ctx.fillStyle = '#b77b4d'; ctx.fillRect(560, 285, 76, 45); ctx.fillStyle = '#eab308'; ctx.fillRect(270, 300, 30, 30); const base = { x: 165, y: 305 }; const dx = armTarget.x - base.x, dy = armTarget.y - base.y; const l1 = 145, l2 = 120; const d = Math.min(l1 + l2 - 2, Math.max(Math.abs(l1 - l2) + 2, Math.hypot(dx, dy))); const a = Math.atan2(dy, dx); const cosine = Math.max(-1, Math.min(1, (l1*l1 + d*d - l2*l2) / (2*l1*d))); const b = Math.acos(cosine); const p1 = { x: base.x + l1 * Math.cos(a - b), y: base.y + l1 * Math.sin(a - b) }; const p2 = { x: p1.x + l2 * Math.cos(Math.atan2(armTarget.y - p1.y, armTarget.x - p1.x)), y: p1.y + l2 * Math.sin(Math.atan2(armTarget.y - p1.y, armTarget.x - p1.x)) }; const seg = (a1, a2, c, w) => { ctx.strokeStyle = c; ctx.lineWidth = w; ctx.lineCap = 'round'; ctx.beginPath(); ctx.moveTo(a1.x, a1.y); ctx.lineTo(a2.x, a2.y); ctx.stroke(); }; seg(base, p1, '#13b9c7', 28); seg(p1, p2, '#f26732', 24); seg(p2, armTarget, '#a7f3d0', 13); [base, p1, p2].forEach((p) => { ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(p.x, p.y, 10, 0, Math.PI*2); ctx.fill(); }); ctx.strokeStyle = '#facc15'; ctx.setLineDash([5, 5]); ctx.strokeRect(armTarget.x - 15, armTarget.y - 15, 30, 30); ctx.setLineDash([]); const torque = val('payload', 150) / 1000 * 9.81 * .145 * 100; label(`target X ${Math.round(armTarget.x)} · Y ${Math.round(armTarget.y)} · shoulder ${torque.toFixed(2)} kg·cm`, 24, 28, torque > 2.2 ? '#ff7b67' : '#8ff5ce'); if (torque > 2.2) { if (alertBox) { alertBox.hidden = false; alertBox.textContent = '⚠️ MG90S 2.2 kg·cm stalls here — upgrade to MG996R / DS3218.'; } } else if (alertBox) alertBox.hidden = true; }
    function drawLine(t) { drawGrid(); if (!ctx) return; ctx.strokeStyle = '#111'; ctx.lineWidth = 34; ctx.beginPath(); ctx.ellipse(380, 220, 260, 150, 0, 0, Math.PI * 2); ctx.stroke(); ctx.strokeStyle = '#2dd4bf'; ctx.lineWidth = 2; ctx.beginPath(); ctx.ellipse(380, 220, 260, 150, 0, 0, Math.PI * 2); ctx.stroke(); const speed = val('base', 130); const angle = t * .0008 * speed; const x = 380 + 260 * Math.cos(angle), y = 220 + 150 * Math.sin(angle); const error = Math.sin(angle * 3) * (val('kp', 1.2) > 4 && val('kd', .4) === 0 ? 70 : 14); ctx.save(); ctx.translate(x + error, y); ctx.rotate(angle + Math.PI/2); ctx.fillStyle = '#f26732'; ctx.fillRect(-18, -11, 36, 22); ctx.fillStyle = '#fff'; [-12, -6, 0, 6, 12].forEach((offset) => { ctx.fillStyle = Math.abs(offset) < 4 ? '#ef4444' : '#10b981'; ctx.beginPath(); ctx.arc(offset, 17, 3.5, 0, Math.PI*2); ctx.fill(); }); ctx.restore(); if (obstacle) { ctx.fillStyle = '#ef4444'; ctx.fillRect(obstacle.x - 12, obstacle.y - 12, 24, 24); if (Math.hypot(x - obstacle.x, y - obstacle.y) < 35 && alertBox) { alertBox.hidden = false; alertBox.textContent = '🛑 HC-SR04 obstacle detected — emergency stop zone'; } } label(`PWM ${Math.round(speed)} · Kp ${val('kp', 1.2).toFixed(1)} · Kd ${val('kd', .4).toFixed(1)}`, 24, 28); }
    function drawRadar(t) { drawGrid(); if (!ctx) return; ctx.fillStyle = '#061d20'; ctx.fillRect(20, 55, 350, 330); ctx.fillStyle = '#251b17'; ctx.fillRect(405, 90, 320, 210); ctx.strokeStyle = '#16a34a'; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(195, 385, 300, Math.PI, Math.PI * 2); ctx.stroke(); const sweep = Math.PI + (t * .0015 % Math.PI); ctx.strokeStyle = '#86efac'; ctx.beginPath(); ctx.moveTo(195, 385); ctx.lineTo(195 + Math.cos(sweep) * 285, 385 + Math.sin(sweep) * 285); ctx.stroke(); const d = radarDistance / 200 * 285; const bx = 195 + Math.cos(Math.PI + .5) * d, by = 385 + Math.sin(Math.PI + .5) * d; ctx.fillStyle = '#ef4444'; ctx.beginPath(); ctx.arc(bx, by, 8, 0, Math.PI*2); ctx.fill(); for (let i = 0; i < 7; i++) { const x = 430 + ((t * .08 + i * 65) % 270); ctx.fillStyle = i % 2 ? '#facc15' : '#60a5fa'; ctx.fillRect(x, 230 - (i % 2) * 38, 32, 25); } ctx.fillStyle = '#4b5563'; ctx.fillRect(405, 250, 320, 18); const hot = root.querySelector('[data-control="driver"]')?.value === 'l298'; label(`distance ${Math.round(radarDistance)} cm · sweep ${Math.round((sweep - Math.PI) * 180 / Math.PI)}°`, 24, 28, '#8ff5ce'); label(`${hot ? 'L298N 78°C · 2.0V drop' : 'TB6612FNG 34°C · MOSFET'} · ${root.querySelector('[data-control="pin"]')?.value === 'adc2' ? 'ADC2 freezes with Wi-Fi' : 'ADC1 safe'}`, 405, 55, hot ? '#ff7b67' : '#8ff5ce'); }
    function drawCurrent(t = performance.now()) { if (selected === 'spiderbot') drawSpider(t); if (selected === 'arm') drawArm(t); if (selected === 'line') drawLine(t); if (selected === 'radar') drawRadar(t); }
    function render(t) { if (!running) return; frame += 1; if (tickLabel) tickLabel.textContent = `frame ${String(frame).padStart(4, '0')}`; drawCurrent(t); raf = requestAnimationFrame(render); }
    function controlsFor(id) { if (id === 'spiderbot') return `<div class="lbr-control-stack"><label>Gait Mode<select data-control="gait"><option value="ripple">Ripple Gait</option><option value="trot">Trot Gait</option><option value="wave">Wave Gait</option><option value="dance">🕺 Dance Mode</option></select></label><label>Walk Speed <output data-output="speed">6 active motors</output><input type="range" min="1" max="12" value="6" data-control="speed"></label><div class="lbr-direction-row"><button type="button" data-direction="1">▲ Forward</button><button type="button" data-direction="-1">◀ Turn Left</button><button type="button" data-direction="1">▶ Turn Right</button></div><label>Power Supply Test<select data-control="power"><option value="good">✅ 7.4V LiPo + 5V 8A Buck + PCA9685</option><option value="bad">🛑 9V Toy Battery / Direct ESP32 5V Pin</option></select></label></div>`; if (id === 'arm') return `<div class="lbr-control-stack"><label>Payload Weight <output data-output="payload">150g</output><input type="range" min="50" max="600" value="150" data-control="payload"></label><p class="lbr-control-help">Click or drag the canvas to set X/Y. Shoulder torque is calculated from payload and 145mm reach.</p></div>`; if (id === 'line') return `<div class="lbr-control-stack"><label>Base Speed PWM <output data-output="base">130</output><input type="range" min="60" max="255" value="130" data-control="base"></label><label>Kp <output data-output="kp">1.2</output><input type="range" min="0" max="8" step="0.1" value="1.2" data-control="kp"></label><label>Kd <output data-output="kd">0.4</output><input type="range" min="0" max="4" step="0.1" value="0.4" data-control="kd"></label><button class="lbr-preset-button" type="button" data-autotune>✨ Auto-Tune Optimal PID</button></div>`; return `<div class="lbr-control-stack"><label>Obstacle / package distance <output data-output="distance">90 cm</output><input type="range" min="5" max="200" value="90" data-control="distance"></label><label>Conveyor Target RPM <output data-output="rpm">160</output><input type="range" min="60" max="300" value="160" data-control="rpm"></label><label>Motor Driver<select data-control="driver"><option value="mosfet">✅ Cool MOSFET TB6612FNG (34°C)</option><option value="l298">🔥 Old Red L298N (2.0V drop, 78°C)</option></select></label><label>ESP32 Pin Choice<select data-control="pin"><option value="adc1">✅ Safe Pin 34 ADC1</option><option value="adc2">🛑 Broken Pin 4 ADC2</option></select></label></div>`; }
    function renderDetail() { const p = profiles[selected]; if (!detail) return; if (mode === 'video') { detail.hidden = false; detail.innerHTML = `<div class="lbr-video-grid">${p.videos.map((id) => `<iframe loading="lazy" title="Robot build guide" data-video-src="https://www.youtube-nocookie.com/embed/${id}" src="about:blank" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`).join('')}</div><p class="lbr-muted-copy">Video embeds are loaded only when this tab is opened. They are external tutorials, not LBR-run simulations.</p>`; detail.querySelectorAll('[data-video-src]').forEach((iframe) => iframe.src = iframe.dataset.videoSrc); } else if (mode === 'wiring') { detail.hidden = false; detail.innerHTML = `<div class="lbr-wiring-card"><strong>${p.name} wiring path</strong><p>${selected === 'spiderbot' ? 'Battery → separate 5V 8A buck → servo rail + PCA9685; ESP32 powers only logic and I²C.' : selected === 'arm' ? 'Use a separate servo rail and calculate shoulder torque before selecting an MG90S.' : selected === 'line' ? 'IR sensors → ESP32 ADC1 → PID loop → MOSFET motor driver; HC-SR04 is an emergency stop input.' : 'HC-SR04 → protected ESP32 input → sorting gate; ADC1 remains usable while Wi-Fi is on.'}</p><div class="lbr-wiring-actions"><a class="lbr-button lbr-button-primary" href="/forge/?preset=${selected === 'spiderbot' ? 'spiderbot-good' : 'conveyor'}">🛒 Load parts in The Forge</a><a class="lbr-button lbr-button-quiet" href="${p.github}" target="_blank" rel="noopener noreferrer">⭐ Open GitHub source ↗</a><button class="lbr-preset-button" type="button" data-copy-badge>📋 Copy GitHub README Badge</button></div><span class="lbr-copy-status" data-badge-status role="status"></span></div>`; detail.querySelector('[data-copy-badge]')?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(`[![${p.name}](https://img.shields.io/badge/LBR-${encodeURIComponent(p.name)}-EA580C)](${location.origin}/robots/)`); detail.querySelector('[data-badge-status]').textContent = 'Badge copied.'; } catch { detail.querySelector('[data-badge-status]').textContent = 'Clipboard blocked; copy from the address bar is still available.'; } }); } else detail.hidden = true; }
    function renderControls() { if (!controls) return; controls.innerHTML = controlsFor(selected); controls.querySelectorAll('input,select').forEach((el) => el.addEventListener('input', () => { if (el.dataset.control === 'gait') gait = el.value; if (el.dataset.control === 'power') spiderPower = el.value; if (el.dataset.control === 'distance') radarDistance = Number(el.value); const output = controls.querySelector(`[data-output="${el.dataset.control}"]`); if (output) output.textContent = el.dataset.control === 'speed' ? `${el.value} active motors` : el.dataset.control === 'payload' ? `${el.value}g` : el.dataset.control === 'distance' ? `${el.value} cm` : el.value; drawCurrent(last); })); controls.querySelectorAll('[data-direction]').forEach((button) => button.addEventListener('click', () => { direction = Number(button.dataset.direction); addLog(`Direction set · ${direction > 0 ? 'forward / right' : 'turn left'}`); drawCurrent(last); })); controls.querySelector('[data-autotune]')?.addEventListener('click', () => { controls.querySelector('[data-control="kp"]').value = '1.2'; controls.querySelector('[data-control="kd"]').value = '0.8'; controls.querySelector('[data-control="kp"]').dispatchEvent(new Event('input')); controls.querySelector('[data-control="kd"]').dispatchEvent(new Event('input')); addLog('Auto-tune applied · Kp 1.2 · Kd 0.8'); }); }
    function stopSim(release = false) { running = false; if (raf) cancelAnimationFrame(raf); raf = undefined; if (status) status.textContent = 'Stopped · animation frame released'; if (play) play.textContent = '▶ Play 60FPS Sim'; if (release) clearActiveIsland(); }
    function startSim() { if (running || !ctx) return; running = true; frame = 0; registerActiveIsland(`robot-${selected}`, () => stopSim(false)); if (status) status.textContent = `Running · ${profiles[selected].name}`; if (play) play.textContent = '⏸ Pause Sim'; if (alertBox) alertBox.hidden = true; addLog(`Started ${profiles[selected].name} · canvas loop active`); raf = requestAnimationFrame((time) => { last = time; render(time); }); }
    function selectProfile(id) { stopSim(true); selected = id; buttons.forEach((button) => { const active = button.dataset.profile === id; button.classList.toggle('is-selected', active); button.setAttribute('aria-selected', String(active)); }); if (desc) desc.textContent = profiles[id].copy; if (status) status.textContent = `Ready · ${profiles[id].name}`; renderControls(); renderDetail(); if (hint) hint.textContent = id === 'arm' ? 'Press Play, then click or drag the canvas to move the arm target.' : id === 'line' ? 'Press Play, then click or drag the canvas to drop an HC-SR04 obstacle.' : id === 'radar' ? 'Press Play, then drag across the canvas to change package distance.' : 'Press Play to animate the canvas.'; drawCurrent(0); addLog(`Selected ${profiles[id].name}`); }
    buttons.forEach((button) => button.addEventListener('click', () => selectProfile(button.dataset.profile))); play?.addEventListener('click', () => running ? stopSim(true) : startSim()); stop?.addEventListener('click', () => { stopSim(true); addLog('Stopped · resources released'); }); root.querySelectorAll('[data-inner-tab]').forEach((tab) => tab.addEventListener('click', () => { mode = tab.dataset.innerTab; root.querySelectorAll('[data-inner-tab]').forEach((item) => item.classList.toggle('is-active', item === tab)); renderDetail(); }));
    function updateCanvasPointer(event) { if (!canvas) return; const rect = canvas.getBoundingClientRect(); const x = (event.clientX - rect.left) * canvas.width / rect.width; const y = (event.clientY - rect.top) * canvas.height / rect.height; if (selected === 'arm') armTarget = { x, y }; if (selected === 'line') obstacle = { x, y }; if (selected === 'radar') radarDistance = Math.round(5 + Math.max(0, Math.min(200, (x / canvas.width) * 200))); drawCurrent(last); }
    canvas?.addEventListener('pointerdown', (event) => { draggingCanvas = true; canvas.setPointerCapture?.(event.pointerId); updateCanvasPointer(event); addLog(selected === 'arm' ? 'Arm target grabbed' : selected === 'line' ? 'HC-SR04 obstacle grabbed' : selected === 'radar' ? `Radar package dragged · ${radarDistance} cm` : 'Canvas interaction started'); }); canvas?.addEventListener('pointermove', (event) => { if (draggingCanvas) updateCanvasPointer(event); }); canvas?.addEventListener('pointerup', (event) => { draggingCanvas = false; canvas.releasePointerCapture?.(event.pointerId); }); canvas?.addEventListener('pointercancel', () => { draggingCanvas = false; }); canvas?.addEventListener('click', (event) => { updateCanvasPointer(event); if (selected === 'arm') addLog(`Arm target set · X ${Math.round(armTarget.x)} Y ${Math.round(armTarget.y)}`); if (selected === 'line') addLog(`HC-SR04 obstacle dropped · X ${Math.round(obstacle.x)} Y ${Math.round(obstacle.y)}`); });
    window.addEventListener('lbr:active-tool-change', () => { if (!window.__LBR_ACTIVE_TOOL_NAME__ && running) { running = false; if (raf) cancelAnimationFrame(raf); raf = undefined; } });
    renderControls(); renderDetail(); if (!ctx) { if (status) status.textContent = 'Canvas unavailable · use a current browser'; if (alertBox) { alertBox.hidden = false; alertBox.textContent = 'This browser cannot create a 2D canvas context. Try Chrome, Edge, or Firefox.'; } if (play) play.disabled = true; } else drawCurrent(performance.now());
  }
</script>
