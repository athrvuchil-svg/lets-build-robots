---
const profiles = [
  { id: 'spiderbot', number: '01', icon: '🐾', name: '4-Legged Spiderbot', copy: 'Watch gait timing, body roll, servo load, and a separate power rail behave like a real bench test.', github: 'https://github.com/adafruit/Adafruit-PWM-Servo-Driver-Library', videos: ['bmoGfBe63ZA', 'iLIIuMj-77w'] },
  { id: 'arm', number: '02', icon: '🦾', name: '6-DOF Desktop Arm', copy: 'Place a target inside the reachable workspace and see links, joints, torque, and the gripper respond.', github: 'https://github.com/ros-controls/ros2_control', videos: ['_B3gWd3A_SI', 'c6mrcNEFBoA'] },
  { id: 'line', number: '03', icon: '🏎️', name: 'PID Line Follower', copy: 'Tune speed and control gains while the rover reads its track, corrects error, and approaches obstacles.', github: 'https://github.com/espressif/arduino-esp32', videos: ['QoNkpnpvEqc'] },
  { id: 'radar', number: '04', icon: '📡', name: 'Radar + Conveyor Sorter', copy: 'Sweep a sonar field, track a package, and compare driver heat and distance decisions in one workcell.', github: 'https://github.com/jrowberg/i2cdevlib', videos: ['6l9DWqb77KI', 'GDnmAI_7lOk'] },
];
---

<section class="lbr-card lbr-sim-workspace lbr-lab-v2" data-local-simulator data-sim-name="robot-lab">
  <div class="lbr-workspace-heading"><div><p class="lbr-kicker">Robot Lab · deterministic workcell</p><h2>See the mechanism, not a placeholder.</h2><p class="lbr-muted-copy">Each scene is a browser model with measurable motion, load, signal, and power readouts. It is visual evidence for learning—not a physics certification.</p></div><div class="lbr-lab-state"><span class="lbr-status-dot"></span><b>LOCAL SIM · 60 FPS</b><small>NO ACCOUNT · NO DOWNLOAD</small></div></div>
  <div class="lbr-task-rail" aria-label="How to use the simulator"><div><b>01 · CHOOSE</b><span>Pick a robot workcell.</span></div><div><b>02 · RUN</b><span>Press Run and watch the canvas move.</span></div><div><b>03 · COMPARE</b><span>Tune a control, then inspect the build.</span></div></div>
  <div class="lbr-sim-layout lbr-real-sim-layout">
    <div class="lbr-profile-list" role="tablist" aria-label="Robot simulator profiles">{profiles.map((profile, index) => <button class:list={{ 'is-selected': index === 0 }} class="lbr-profile-button" type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-profile={profile.id}><span class="lbr-profile-number">{profile.number}</span><span><strong>{profile.icon} {profile.name}</strong><small>{profile.copy}</small></span></button>)}</div>
    <div class="lbr-sim-main"><div class="lbr-inner-tabs" role="tablist" aria-label="Simulator details"><button class="lbr-inner-tab is-active" data-inner-tab="visual" type="button">◉ LIVE WORKCELL</button><button class="lbr-inner-tab" data-inner-tab="video" type="button">WATCH BUILD</button><button class="lbr-inner-tab" data-inner-tab="wiring" type="button">WIRING + PARTS</button></div><div class="lbr-sim-stage" data-sim-stage><canvas width="840" height="500" data-sim-canvas aria-label="Interactive robotics workcell simulation"></canvas><div class="lbr-sim-fallback" data-sim-fallback aria-hidden="true"><div class="lbr-fallback-robot"><i></i><i></i><i></i><i></i></div><strong>Local robot preview</strong><small>Press Play to start the workcell.</small></div><div class="lbr-sim-alert" data-sim-alert hidden></div><span class="lbr-canvas-hint" data-canvas-hint>Press Play to run the workcell.</span></div><div class="lbr-sim-detail-panel" data-detail-panel hidden></div></div>
    <div class="lbr-sim-console"><div class="lbr-console-top"><span data-sim-status>Ready · choose a workcell</span><span class="font-mono" data-sim-tick>frame 0000</span></div><p data-sim-description>{profiles[0].copy}</p><div data-sim-controls></div><div class="lbr-sim-actions"><button class="lbr-button lbr-button-primary" type="button" data-sim-play>▶ Run workcell</button><button class="lbr-button lbr-button-quiet" type="button" data-sim-stop>■ Stop + release</button></div><div class="lbr-log-wrap"><div class="lbr-log-heading"><strong>Bench events</strong><span class="eng-only-inline">managed 60Hz loop</span></div><ul class="lbr-run-log" data-run-log><li>Ready · no simulator is running</li></ul></div><p class="eng-only lbr-engineer-note">Only this workcell owns a timer and animation frame. Switching tools releases both through window.__LBR_ACTIVE_TOOL__.</p></div>
  </div>
</section>

<script>
  // @ts-nocheck
  import { registerActiveIsland, clearActiveIsland } from '../utils/islandRegistry';
  import { renderCanvasFrame } from '../utils/canvasFrame.mjs';
  const root = document.querySelector('[data-local-simulator]');
  if (root) {
    const profiles = { spiderbot: { name: '4-Legged Spiderbot', copy: 'Watch gait timing, body roll, servo load, and a separate power rail behave like a real bench test.', github: 'https://github.com/adafruit/Adafruit-PWM-Servo-Driver-Library', videos: ['bmoGfBe63ZA', 'iLIIuMj-77w'] }, arm: { name: '6-DOF Desktop Arm', copy: 'Place a target inside the reachable workspace and see links, joints, torque, and the gripper respond.', github: 'https://github.com/ros-controls/ros2_control', videos: ['_B3gWd3A_SI', 'c6mrcNEFBoA'] }, line: { name: 'PID Line Follower', copy: 'Tune speed and control gains while the rover reads its track, corrects error, and approaches obstacles.', github: 'https://github.com/espressif/arduino-esp32', videos: ['QoNkpnpvEqc'] }, radar: { name: 'Radar + Conveyor Sorter', copy: 'Sweep a sonar field, track a package, and compare driver heat and distance decisions in one workcell.', github: 'https://github.com/jrowberg/i2cdevlib', videos: ['6l9DWqb77KI', 'GDnmAI_7lOk'] } };
    const buttons = [...root.querySelectorAll('[data-profile]')]; const canvas = root.querySelector('[data-sim-canvas]'); let ctx = null; try { ctx = canvas?.getContext('2d') ?? null; } catch { ctx = null; }
    const stage = root.querySelector('[data-sim-stage]'); const fallback = root.querySelector('[data-sim-fallback]'); const controls = root.querySelector('[data-sim-controls]'); const detail = root.querySelector('[data-detail-panel]'); const status = root.querySelector('[data-sim-status]'); const tickLabel = root.querySelector('[data-sim-tick]'); const desc = root.querySelector('[data-sim-description]'); const log = root.querySelector('[data-run-log]'); const play = root.querySelector('[data-sim-play]'); const stop = root.querySelector('[data-sim-stop]'); const alertBox = root.querySelector('[data-sim-alert]'); const hint = root.querySelector('[data-canvas-hint]');
    let selected = 'spiderbot'; let running = false; let timer; let raf; let frame = 0; let last = performance.now(); let mode = 'visual'; let armTarget = { x: 590, y: 250 }; let obstacle = { x: 650, y: 235 }; let radarDistance = 92; let spiderPower = 'good'; let gait = 'ripple'; let direction = 1; let state = { speed: 6, kp: 1.2, kd: .4, payload: 150, rpm: 160, driver: 'mosfet', pin: 'adc1' };
    const TAU = Math.PI * 2; const clamp = (n, min, max) => Math.max(min, Math.min(max, n)); const val = (key, fallbackValue) => Number(root.querySelector(`[data-control="${key}"]`)?.value ?? fallbackValue); const addLog = (text) => { if (!log) return; const li = document.createElement('li'); li.textContent = text; log.prepend(li); while (log.children.length > 6) log.lastElementChild?.remove(); };
    const color = { ink: '#0b1720', panel: '#152631', cyan: '#45d9c2', orange: '#ff704d', yellow: '#f5ca65', green: '#8be0b0', muted: '#8ca2ac', white: '#f4f8f7', red: '#ff6e68' };
    function rounded(x, y, w, h, r, fill, stroke) { if (!ctx) return; ctx.beginPath(); ctx.roundRect(x, y, w, h, r); if (fill) { ctx.fillStyle = fill; ctx.fill(); } if (stroke) { ctx.strokeStyle = stroke; ctx.stroke(); } }
    function text(value, x, y, size = 12, fill = color.white, weight = 600) { if (!ctx) return; ctx.fillStyle = fill; ctx.font = `${weight} ${size}px JetBrains Mono, monospace`; ctx.fillText(value, x, y); }
    function line(x1, y1, x2, y2, stroke, width = 1, dash = []) { if (!ctx) return; ctx.save(); ctx.strokeStyle = stroke; ctx.lineWidth = width; ctx.setLineDash(dash); ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); ctx.restore(); }
    function circle(x, y, radius, fill, stroke, width = 1) { if (!ctx) return; ctx.beginPath(); ctx.arc(x, y, radius, 0, TAU); if (fill) { ctx.fillStyle = fill; ctx.fill(); } if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = width; ctx.stroke(); } }
    function panel(x, y, w, h, title, value, detailText, accent = color.cyan) { rounded(x, y, w, h, 8, 'rgba(11,23,32,.78)', 'rgba(244,248,247,.16)'); text(title, x + 12, y + 18, 9, color.muted, 700); text(value, x + 12, y + 42, 18, accent, 800); text(detailText, x + 12, y + h - 12, 9, color.muted, 600); }
    function workcell(label, sub = 'LOCAL MODEL · NOT A PHYSICS CERTIFICATION') { if (!ctx || !canvas) return; const w = canvas.width, h = canvas.height; const gradient = ctx.createLinearGradient(0, 0, 0, h); gradient.addColorStop(0, '#132b3a'); gradient.addColorStop(1, '#09141b'); ctx.fillStyle = gradient; ctx.fillRect(0, 0, w, h); ctx.strokeStyle = 'rgba(69,217,194,.12)'; ctx.lineWidth = 1; for (let x = 0; x <= w; x += 42) line(x, 0, x - 180, h, 'rgba(69,217,194,.12)'); for (let y = 110; y <= h; y += 32) line(0, y, w, y, 'rgba(244,248,247,.06)'); text('LBR / ROBOT LAB', 20, 28, 10, color.cyan, 800); text(label.toUpperCase(), 20, 49, 17, color.white, 800); text(sub, 20, 68, 9, color.muted, 600); }
    function drawShadow(x, y, rx, ry, alpha = .35) { if (!ctx) return; ctx.save(); ctx.fillStyle = `rgba(0,0,0,${alpha})`; ctx.beginPath(); ctx.ellipse(x, y, rx, ry, 0, 0, TAU); ctx.fill(); ctx.restore(); }
    function drawSpider(t) { workcell('SPIDERBOT / GAIT TEST'); const phase = t * .004 * (val('speed', 6) / 6) * direction; const bad = spiderPower === 'bad'; const bodyX = 425, bodyY = 270 + Math.sin(phase * 2) * 2, roll = Math.sin(phase) * .035; drawShadow(bodyX, 405, 170, 24, .48); ctx.save(); ctx.translate(bodyX, bodyY); ctx.rotate(roll); const legs = [[-70,-25,-150,-88,-205,-52], [70,-25,150,-88,205,-52], [-70,25,-150,88,-205,52], [70,25,150,88,205,52]]; legs.forEach((leg, i) => { const gaitOffset = gait === 'trot' ? (i % 2) * Math.PI : gait === 'wave' ? i * Math.PI / 2 : i * Math.PI / 4; const lift = Math.max(0, Math.sin(phase + gaitOffset)) * 22; const kneeX = leg[2] + Math.sin(phase + gaitOffset) * 10, kneeY = leg[3] - lift; const footX = leg[4] + Math.sin(phase + gaitOffset) * 14, footY = leg[5] - lift; line(leg[0], leg[1], kneeX, kneeY, bad ? color.red : i % 2 ? color.orange : color.cyan, 15); line(kneeX, kneeY, footX, footY, bad ? '#c84c55' : color.green, 12); circle(kneeX, kneeY, 8, color.ink, color.white, 2); circle(footX, footY, 6, bad ? color.red : color.yellow); }); rounded(-80, -54, 160, 108, 30, '#1d3b4a', bad ? color.red : color.cyan); rounded(-53, -32, 106, 64, 18, '#224b59', 'rgba(244,248,247,.35)'); circle(-24, -7, 10, color.white); circle(24, -7, 10, color.white); line(-20, 25, 20, 25, color.orange, 6); ctx.restore(); const voltage = bad ? 3.15 + Math.abs(Math.sin(t * .012)) * .3 : 5; const current = bad ? 2.2 : 5.1 + Math.abs(Math.sin(t * .005)) * 2.2; panel(24, 100, 145, 88, 'SERVO RAIL', `${voltage.toFixed(2)} V`, bad ? 'BROWNOUT RISK' : '5V 8A BUCK · STABLE', bad ? color.red : color.green); panel(185, 100, 145, 88, 'LOAD', `${current.toFixed(1)} A`, '12 CHANNELS · PEAK MODEL', current > 8 ? color.orange : color.cyan); panel(346, 100, 145, 88, 'GAIT', gait.toUpperCase(), `${Math.round((phase % TAU + TAU) % TAU * 57.3)}° PHASE`, color.yellow); panel(507, 100, 145, 88, 'BODY', `${(Math.sin(phase) * 2.1).toFixed(1)}°`, 'ROLL · IMU ESTIMATE', color.cyan); text('PCA9685 / 0x40', 695, 130, 10, color.muted, 700); text(bad ? 'DIRECT ESP32 RAIL' : 'SEPARATE LOGIC + SERVO POWER', 695, 148, 9, bad ? color.red : color.green, 700); }
    function drawArm(t) { workcell('ARM / REACH TEST'); const base = { x: 190, y: 380 }, l1 = 155, l2 = 132; const dx = armTarget.x - base.x, dy = armTarget.y - base.y; const distance = clamp(Math.hypot(dx, dy), Math.abs(l1 - l2) + 3, l1 + l2 - 3); const a = Math.atan2(dy, dx); const b = Math.acos(clamp((l1 * l1 + distance * distance - l2 * l2) / (2 * l1 * distance), -1, 1)); const shoulder = { x: base.x + l1 * Math.cos(a - b), y: base.y + l1 * Math.sin(a - b) }; const wrist = { x: armTarget.x, y: armTarget.y }; drawShadow(310, 421, 170, 18); ctx.save(); ctx.strokeStyle = 'rgba(69,217,194,.35)'; ctx.setLineDash([6, 7]); ctx.beginPath(); ctx.arc(base.x, base.y, l1 + l2, Math.PI * 1.1, Math.PI * 1.9); ctx.stroke(); ctx.beginPath(); ctx.arc(base.x, base.y, Math.abs(l1 - l2), Math.PI * 1.1, Math.PI * 1.9); ctx.stroke(); ctx.restore(); line(base.x, base.y, shoulder.x, shoulder.y, '#2d9cb0', 32); line(shoulder.x, shoulder.y, wrist.x, wrist.y, color.orange, 27); line(wrist.x, wrist.y, wrist.x + 35, wrist.y + 5, color.green, 11); circle(base.x, base.y, 22, color.ink, color.white, 3); circle(shoulder.x, shoulder.y, 15, color.ink, color.cyan, 3); circle(wrist.x, wrist.y, 13, color.ink, color.yellow, 3); line(wrist.x + 28, wrist.y - 10, wrist.x + 46, wrist.y - 25, color.green, 6); line(wrist.x + 28, wrist.y + 10, wrist.x + 46, wrist.y + 25, color.green, 6); circle(armTarget.x, armTarget.y, 17, 'rgba(245,202,101,.12)', color.yellow, 2); line(armTarget.x - 28, armTarget.y, armTarget.x + 28, armTarget.y, color.yellow, 1, [4, 5]); line(armTarget.x, armTarget.y - 28, armTarget.x, armTarget.y + 28, color.yellow, 1, [4, 5]); const torque = val('payload', 150) / 1000 * 9.81 * .155 * 100; panel(24, 100, 160, 88, 'TARGET', `${Math.round(armTarget.x)}, ${Math.round(armTarget.y)}`, 'CLICK / DRAG WORKSPACE', color.yellow); panel(200, 100, 160, 88, 'REACH', `${Math.round(distance)} mm`, distance > 270 ? 'NEAR LIMIT' : 'WITHIN WORKSPACE', distance > 270 ? color.orange : color.green); panel(376, 100, 160, 88, 'SHOULDER', `${torque.toFixed(2)} kg·cm`, `${val('payload', 150)}g PAYLOAD`, torque > 2.2 ? color.red : color.cyan); panel(552, 100, 160, 88, 'GRIPPER', `${Math.round(50 + Math.sin(t * .003) * 18)}%`, 'POSITION LOOP', color.green); text('145 mm LINK · IK SOLUTION', 570, 420, 10, color.muted, 700); if (torque > 2.2 && alertBox) { alertBox.hidden = false; alertBox.textContent = 'Torque warning · MG90S margin is exceeded at this target.'; } else if (alertBox) alertBox.hidden = true; }
    function drawLine(t) { workcell('ROVER / PID TRACK TEST'); const speed = val('base', 130); const kp = val('kp', 1.2); const kd = val('kd', .4); const trackY = 318; const error = Math.sin(t * .001 * speed * .04) * (kp > 4 && kd === 0 ? 80 : 18); const roverX = 420 + error; drawShadow(roverX, 420, 74, 15); ctx.fillStyle = '#f0ede3'; ctx.beginPath(); ctx.moveTo(80, 220); ctx.lineTo(760, 220); ctx.lineTo(680, 460); ctx.lineTo(155, 460); ctx.closePath(); ctx.fill(); ctx.strokeStyle = '#26353a'; ctx.lineWidth = 28; ctx.beginPath(); ctx.moveTo(100, trackY); ctx.bezierCurveTo(250, 270, 400, 370, 740, 300); ctx.stroke(); ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(100, trackY); ctx.bezierCurveTo(250, 270, 400, 370, 740, 300); ctx.stroke(); const sensorY = 385; for (let i = -2; i <= 2; i++) { const sx = roverX + i * 18; line(sx, sensorY, sx + error * .35, sensorY + 28, i === 0 ? color.red : color.cyan, i === 0 ? 4 : 2); circle(sx, sensorY, 5, i === 0 ? color.red : color.cyan); } rounded(roverX - 48, 350, 96, 58, 12, '#24495a', color.orange); rounded(roverX - 31, 362, 62, 26, 7, '#14242c', color.cyan); circle(roverX - 25, 420, 13, color.ink, color.white, 2); circle(roverX + 25, 420, 13, color.ink, color.white, 2); const obstacleNear = Math.hypot(roverX - obstacle.x, trackY - obstacle.y) < 55; if (obstacle) { circle(obstacle.x, obstacle.y, 16, obstacleNear ? color.red : color.orange, color.white, 2); text('OBSTACLE', obstacle.x - 30, obstacle.y - 24, 9, color.red, 800); } panel(24, 100, 155, 88, 'SPEED', `${Math.round(speed)} PWM`, `${(speed / 255 * 100).toFixed(0)}% COMMAND`, color.orange); panel(195, 100, 155, 88, 'TRACK ERROR', `${error.toFixed(1)} mm`, `KP ${kp.toFixed(1)} · KD ${kd.toFixed(1)}`, Math.abs(error) > 45 ? color.red : color.cyan); panel(366, 100, 155, 88, 'SENSORS', `${Math.round(50 + Math.abs(error))}%`, 'QTR-8A ARRAY', color.green); panel(537, 100, 155, 88, 'DRIVE', obstacleNear ? 'STOP' : 'TRACKING', obstacleNear ? 'HC-SR04 TRIP' : 'MOSFET DRIVER', obstacleNear ? color.red : color.green); if (obstacleNear && alertBox) { alertBox.hidden = false; alertBox.textContent = 'Obstacle detected · emergency stop zone is active.'; } else if (alertBox) alertBox.hidden = true; }
    function drawRadar(t) { workcell('SORTER / SENSOR FUSION TEST'); const sweep = Math.PI + (t * .0018 % Math.PI); const cx = 220, cy = 390, radius = 230; ctx.fillStyle = '#06191e'; ctx.fillRect(24, 105, 390, 355); for (let ring = 1; ring <= 3; ring++) { ctx.strokeStyle = `rgba(69,217,194,${.28 - ring * .05})`; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(cx, cy, radius * ring / 3, Math.PI, TAU); ctx.stroke(); } line(cx, cy, cx + Math.cos(sweep) * radius, cy + Math.sin(sweep) * radius, color.green, 3); const d = radarDistance / 200 * radius; const bx = cx + Math.cos(Math.PI + .55) * d, by = cy + Math.sin(Math.PI + .55) * d; circle(bx, by, 9, color.orange); text(`${Math.round(radarDistance)} cm`, bx + 12, by + 4, 10, color.yellow, 700); const beltX = 470, beltY = 175, beltW = 300, beltH = 220; rounded(beltX, beltY, beltW, beltH, 10, '#18262e', 'rgba(244,248,247,.15)'); for (let x = beltX + 12; x < beltX + beltW - 10; x += 25) line(x, beltY + 42, x + 14, beltY + beltH - 25, 'rgba(244,248,247,.1)', 2); const packageX = beltX + 48 + ((t * .08) % (beltW - 90)); rounded(packageX, beltY + 92, 42, 34, 5, color.yellow, color.orange); text('SORT', beltX + 15, beltY + 25, 10, color.cyan, 800); line(beltX + 15, beltY + 62, beltX + beltW - 15, beltY + 62, color.cyan, 2); const hot = root.querySelector('[data-control="driver"]')?.value === 'l298'; panel(24, 100, 145, 72, 'SONAR', `${Math.round(radarDistance)} cm`, 'HC-SR04 RANGE', color.green); panel(185, 100, 145, 72, 'SWEEP', `${Math.round((sweep - Math.PI) * 180 / Math.PI)}°`, 'FIELD OF VIEW', color.cyan); panel(346, 100, 145, 72, 'DRIVER', hot ? '78°C' : '34°C', hot ? 'L298N · LOSSY' : 'MOSFET · CLEAN', hot ? color.red : color.green); panel(507, 100, 145, 72, 'QUEUE', `${Math.round(packageX - beltX)} mm`, 'CONVEYOR POSITION', color.yellow); text('ADC1 SAFE · TXS0108E PROTECTED INPUT', 470, 430, 9, color.muted, 700); }
    function drawCurrent(t = performance.now()) { if (selected === 'spiderbot') drawSpider(t); if (selected === 'arm') drawArm(t); if (selected === 'line') drawLine(t); if (selected === 'radar') drawRadar(t); }
    function render(t) { if (!running) return; frame += 1; if (tickLabel) tickLabel.textContent = `frame ${String(frame).padStart(4, '0')}`; try { renderCanvasFrame(canvas, () => drawCurrent(t)); } catch (error) { stopSim(false); if (status) status.textContent = 'Stopped · drawing error'; addLog(`Drawing error · ${error instanceof Error ? error.message : 'unknown canvas error'}`); } }
    function controlsFor(id) { if (id === 'spiderbot') return `<div class="lbr-control-stack"><label>Gait<select data-control="gait"><option value="ripple">Ripple gait</option><option value="trot">Trot gait</option><option value="wave">Wave gait</option></select></label><label>Speed <output data-output="speed">6x</output><input type="range" min="1" max="12" value="6" data-control="speed"></label><label>Power path<select data-control="power"><option value="good">7.4V LiPo · buck · PCA9685</option><option value="bad">9V toy battery · direct rail</option></select></label><div class="lbr-direction-row"><button type="button" data-direction="1">↑ Forward</button><button type="button" data-direction="-1">← Turn</button></div></div>`; if (id === 'arm') return `<div class="lbr-control-stack"><label>Payload <output data-output="payload">150g</output><input type="range" min="50" max="600" value="150" data-control="payload"></label><p class="lbr-control-help">Drag the target inside the reachable envelope.</p></div>`; if (id === 'line') return `<div class="lbr-control-stack"><label>Base speed <output data-output="base">130 PWM</output><input type="range" min="60" max="255" value="130" data-control="base"></label><label>Kp <output data-output="kp">1.2</output><input type="range" min="0" max="8" step="0.1" value="1.2" data-control="kp"></label><label>Kd <output data-output="kd">0.4</output><input type="range" min="0" max="4" step="0.1" value="0.4" data-control="kd"></label></div>`; return `<div class="lbr-control-stack"><label>Package distance <output data-output="distance">92 cm</output><input type="range" min="5" max="200" value="92" data-control="distance"></label><label>Driver<select data-control="driver"><option value="mosfet">TB6612FNG / MOSFET</option><option value="l298">L298N / BJT</option></select></label><label>Sensor pin<select data-control="pin"><option value="adc1">ADC1 · Wi-Fi safe</option><option value="adc2">ADC2 · Wi-Fi trap</option></select></label></div>`; }
    function renderControls() { if (!controls) return; controls.innerHTML = controlsFor(selected); controls.querySelectorAll('input,select').forEach((el) => el.addEventListener('input', () => { if (el.dataset.control === 'gait') gait = el.value; if (el.dataset.control === 'power') spiderPower = el.value; if (el.dataset.control === 'distance') radarDistance = Number(el.value); const output = controls.querySelector(`[data-output="${el.dataset.control}"]`); if (output) output.textContent = el.dataset.control === 'speed' ? `${el.value}x` : el.dataset.control === 'payload' ? `${el.value}g` : el.dataset.control === 'base' ? `${el.value} PWM` : el.dataset.control === 'distance' ? `${el.value} cm` : el.value; drawCurrent(last); })); controls.querySelectorAll('[data-direction]').forEach((button) => button.addEventListener('click', () => { direction = Number(button.dataset.direction); addLog(`Direction set · ${direction > 0 ? 'forward' : 'turn left'}`); })); }
    function renderDetail() { const p = profiles[selected]; if (!detail) return; if (mode === 'video') { detail.hidden = false; detail.innerHTML = `<div class="lbr-video-grid">${p.videos.map((id) => `<iframe loading="lazy" title="YouTube build tutorial for ${p.name}" src="https://www.youtube-nocookie.com/embed/${id}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`).join('')}</div><p class="lbr-muted-copy">Watch the physical build beside the local model, then return to tune the same idea.</p>`; } else if (mode === 'wiring') { detail.hidden = false; detail.innerHTML = `<div class="lbr-wiring-card"><strong>${p.name} / practical wiring path</strong><p>${selected === 'spiderbot' ? 'Battery → separate 5V buck → servo rail + PCA9685; ESP32 powers logic and I²C only.' : selected === 'arm' ? 'Separate servo rail, shared ground, and torque check before choosing the actuator.' : selected === 'line' ? 'QTR array → ESP32 ADC1 → PID loop → MOSFET driver; ultrasonic input is protected.' : 'HC-SR04 → protected ESP32 input → sorting gate; ADC1 stays usable with Wi-Fi.'}</p><div class="lbr-wiring-actions"><a class="lbr-button lbr-button-primary" href="/forge/?preset=${selected === 'spiderbot' ? 'spiderbot-good' : 'conveyor'}">Open parts in Forge →</a><a class="lbr-button lbr-button-quiet" href="${p.github}" target="_blank" rel="noopener noreferrer">Open source ↗</a></div></div>`; } else { detail.hidden = true; detail.innerHTML = ''; } }
    function stopSim(release = false) { running = false; if (timer) window.clearInterval(timer); if (raf) cancelAnimationFrame(raf); timer = undefined; raf = undefined; stage?.classList.remove('is-running'); if (status) status.textContent = 'Stopped · workcell released'; if (play) play.textContent = '▶ Run workcell'; if (release) clearActiveIsland(); }
    function startSim() { if (running) { stopSim(true); return; } if (!ctx) { if (status) status.textContent = 'Cannot start · canvas unavailable'; return; } try { running = true; frame = 0; stage?.classList.add('is-running'); registerActiveIsland(`robot-${selected}`, () => stopSim(false)); if (status) status.textContent = `Running · ${profiles[selected].name}`; if (play) play.textContent = '⏸ Pause workcell'; if (alertBox) alertBox.hidden = true; addLog(`Started ${profiles[selected].name} · 60Hz workcell`); timer = window.setInterval(() => render(performance.now()), 1000 / 60); raf = requestAnimationFrame((time) => { last = time; render(time); }); } catch (error) { running = false; stage?.classList.remove('is-running'); if (status) status.textContent = 'Could not start · refresh and try again'; addLog(`Start error · ${error instanceof Error ? error.message : 'unknown browser error'}`); } }
    function selectProfile(id) { stopSim(true); selected = id; buttons.forEach((button) => { const active = button.dataset.profile === id; button.classList.toggle('is-selected', active); button.setAttribute('aria-selected', String(active)); }); if (desc) desc.textContent = profiles[id].copy; if (status) status.textContent = `Ready · ${profiles[id].name}`; renderControls(); renderDetail(); if (hint) hint.textContent = id === 'arm' ? 'Press Play, then click or drag the target.' : id === 'line' ? 'Press Play, then place an obstacle on the track.' : id === 'radar' ? 'Press Play, then adjust range and driver heat.' : 'Press Play to run the gait model.'; drawCurrent(performance.now()); addLog(`Selected ${profiles[id].name}`); }
    function updateCanvasPointer(event) { if (!canvas) return; const rect = canvas.getBoundingClientRect(); const x = (event.clientX - rect.left) * canvas.width / rect.width; const y = (event.clientY - rect.top) * canvas.height / rect.height; if (selected === 'arm') armTarget = { x: clamp(x, 100, 760), y: clamp(y, 185, 405) }; if (selected === 'line') obstacle = { x: clamp(x, 120, 760), y: clamp(y, 220, 410) }; if (selected === 'radar') radarDistance = Math.round(5 + clamp(x / canvas.width, 0, 1) * 195); drawCurrent(last); }
    buttons.forEach((button) => button.addEventListener('click', () => selectProfile(button.dataset.profile))); play?.addEventListener('click', startSim); stop?.addEventListener('click', () => { stopSim(true); addLog('Stopped · resources released'); }); root.querySelectorAll('[data-inner-tab]').forEach((tab) => tab.addEventListener('click', () => { mode = tab.dataset.innerTab; root.querySelectorAll('[data-inner-tab]').forEach((item) => item.classList.toggle('is-active', item === tab)); renderDetail(); }));
    let dragging = false; canvas?.addEventListener('pointerdown', (event) => { dragging = true; canvas.setPointerCapture?.(event.pointerId); updateCanvasPointer(event); addLog('Workcell pointer engaged'); }); canvas?.addEventListener('pointermove', (event) => { if (dragging) updateCanvasPointer(event); }); canvas?.addEventListener('pointerup', (event) => { dragging = false; canvas.releasePointerCapture?.(event.pointerId); }); canvas?.addEventListener('pointercancel', () => { dragging = false; });
    window.addEventListener('lbr:active-tool-change', () => { if (!window.__LBR_ACTIVE_TOOL_NAME__ && running) stopSim(false); }); renderControls(); renderDetail(); if (!ctx) { if (status) status.textContent = 'Canvas unavailable · preview fallback shown'; if (alertBox) { alertBox.hidden = false; alertBox.textContent = 'This browser cannot create a 2D canvas context. The static preview remains available.'; } if (play) play.disabled = true; if (fallback) fallback.setAttribute('aria-hidden', 'false'); } else { stage?.classList.add('is-canvas-ready'); if (fallback) fallback.setAttribute('aria-hidden', 'true'); drawCurrent(performance.now()); }
  }
</script>
